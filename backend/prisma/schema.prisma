/// งานนำเข้าข้อมูลจากไฟล์ Excel (หน้า ผู้ดูแลระบบ › นำเข้าข้อมูล)
///
/// เก็บไฟล์ต้นฉบับไว้กับงาน แทนที่จะให้หน้าเว็บส่งแถวทั้งหมดกลับมาตอนกดยืนยัน
/// ผลที่ได้คือ "ที่พรีวิวเห็น" กับ "ที่เขียนจริง" มาจากไฟล์ก้อนเดียวกันเสมอ
/// และย้อนดูได้ว่าใครนำเข้าไฟล์ไหน ผลออกมาอย่างไร
model DataImport {
  id        String @id @default(cuid())
  companyId String

  type   DataImportType
  status DataImportStatus @default(ANALYZED)

  fileName String
  fileSize Int?
  mimeType String?

  storageProvider String  @default("LOCAL")
  storageKey      String
  bucketName      String?

  sheetName   String?
  headerRowNo Int?

  /// การจับคู่คอลัมน์ที่ใช้จริง — { fieldKey: หมายเลขคอลัมน์เริ่มที่ 1 }
  mapping Json?

  duplicateMode DataImportDuplicateMode @default(UPDATE)

  totalRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  errorRows   Int @default(0)

  errorMessage String?

  /// แถวที่นำเข้าไม่สำเร็จ เก็บไว้ให้เปิดดูย้อนหลังโดยไม่ต้องเปิดไฟล์เดิม
  rowErrors Json?

  committedAt DateTime?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("DataImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, type, createdAt])
  @@index([status])
  @@index([createdById])
  @@map("data_imports")
}

/// ประเภทการลาระดับ "ระบบ" (master กลาง ไม่ผูกกับบริษัท)
/// บริษัท/สาขาไหนต้องการใช้ จึงกดเปิดใช้ ระบบจะสร้าง LeaveType ของบริษัทนั้นจากค่าตั้งต้นที่นี่
model LeaveTypeCatalog {
  id String @id @default(cuid())

  /// รหัสอ้างอิงตามเอกสารมาตรฐาน เช่น "01".."16"
  referenceCode String
  code          String
  nameTh        String
  nameEn        String?
  description   String?
  sortOrder     Int     @default(0)

  /// true = รายการมาตรฐานที่ระบบ seed มา ห้ามลบ
  isSystem Boolean @default(true)

  isPaid             Boolean @default(true)
  requiresAttachment Boolean @default(false)
  allowHalfDay       Boolean @default(true)
  allowHourly        Boolean @default(false)

  deductQuota      Boolean @default(true)
  affectAttendance Boolean @default(true)
  affectPayroll    Boolean @default(true)

  minLeaveUnitMinutes    Int      @default(240)
  maxLeaveDaysPerRequest Decimal? @db.Decimal(8, 2)

  advanceNoticeDays           Int     @default(0)
  allowBackdated              Boolean @default(false)
  maxBackdatedDays            Int     @default(0)
  backdatedRequiresAttachment Boolean @default(false)
  backdatedRequiresHrApproval Boolean @default(true)

  allowNegativeBalance Boolean @default(false)
  negativeBalanceMode  String?
  enforceQuotaLimit    Boolean @default(true)

  /// true = วันหยุดที่คร่อมอยู่ในช่วงลา ถูกนับเป็นวันลาด้วย (พฤติกรรมเดิมของระบบ)
  includeHoliday Boolean @default(true)
  includeWeekend Boolean @default(true)

  attachmentRequiredAfterDays Decimal? @db.Decimal(8, 2)

  quotaAccrualYears Int                    @default(1)
  genderEligibility LeaveGenderEligibility @default(ALL)
  serviceStartBasis LeaveServiceStartBasis @default(HIRE_DATE)

  /// ต้องผ่านการบรรจุก่อนถึงจะยื่นลาประเภทนี้ได้หรือไม่
  ///
  /// แยกออกจาก serviceStartBasis โดยตั้งใจ — ของเดิมใช้ค่าเดียวทำสองหน้าที่
  /// คือทั้ง "นับอายุงานเพื่อคิดโควตา" และ "บล็อกไม่ให้ยื่น" ปนกัน
  /// HR ที่อยากให้ลาพักร้อนนับอายุงานจากวันบรรจุ จึงเผลอบล็อกลาป่วยไปด้วย
  /// โดยไม่มีอะไรเตือน ดู statutory-leave.util.ts ที่เป็นเพดานล่างตามกฎหมาย
  requireProbationPassed Boolean               @default(false)
  prorateFirstYear       Boolean               @default(false)
  roundingMode           LeaveRoundingMode     @default(NONE)
  quotaDisplayUnit       LeaveQuotaDisplayUnit @default(DAY)

  /// ค่าตั้งต้นระดับนโยบาย ใช้ตอนบริษัทกดเปิดใช้ครั้งแรก
