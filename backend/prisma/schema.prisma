  lateRoundingMinutes     Int      @default(0)
  maxLatePenaltyPerDay    Decimal? @db.Decimal(14, 2)
  maxMissingPenaltyPerDay Decimal? @db.Decimal(14, 2)
  missingPenaltyMode      String   @default("PER_SESSION")
  offsiteEnabled          Boolean  @default(false)
  requireOffsiteApproval  Boolean  @default(true)

