  defaultIncludeInSocialSecurity   Boolean @default(false)
  defaultAllowCarryForward         Boolean @default(false)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
