  isSocialSecurityBase Boolean @default(false)
  isRecurring          Boolean @default(false)

  sortOrder Int @default(0)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
