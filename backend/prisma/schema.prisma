}

model EmployeeWorkHistory {
  id         String @id @default(cuid())
  employeeId String

  type          WorkHistoryType
  effectiveDate DateTime
  title         String
  description   String?

  oldCompanyId      String?
  newCompanyId      String?
  oldBranchId       String?
  newBranchId       String?
  oldDepartmentId   String?
  newDepartmentId   String?
  oldDivisionId     String?
  newDivisionId     String?
  oldEmployeeTypeId String?
  newEmployeeTypeId String?

  oldPosition String?
  newPosition String?

  oldStatus EmployeeStatus?
  newStatus EmployeeStatus?

  createdById String?
  createdAt   DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  oldCompany Company? @relation("EmployeeWorkHistoryOldCompany", fields: [oldCompanyId], references: [id], onDelete: SetNull)
  newCompany Company? @relation("EmployeeWorkHistoryNewCompany", fields: [newCompanyId], references: [id], onDelete: SetNull)

  oldBranch Branch? @relation("EmployeeWorkHistoryOldBranch", fields: [oldBranchId], references: [id], onDelete: SetNull)
  newBranch Branch? @relation("EmployeeWorkHistoryNewBranch", fields: [newBranchId], references: [id], onDelete: SetNull)

  oldDepartment Department? @relation("EmployeeWorkHistoryOldDepartment", fields: [oldDepartmentId], references: [id], onDelete: SetNull)
  newDepartment Department? @relation("EmployeeWorkHistoryNewDepartment", fields: [newDepartmentId], references: [id], onDelete: SetNull)

  oldDivision Division? @relation("EmployeeWorkHistoryOldDivision", fields: [oldDivisionId], references: [id], onDelete: SetNull)
  newDivision Division? @relation("EmployeeWorkHistoryNewDivision", fields: [newDivisionId], references: [id], onDelete: SetNull)

  oldEmployeeType EmployeeType? @relation("EmployeeWorkHistoryOldEmployeeType", fields: [oldEmployeeTypeId], references: [id], onDelete: SetNull)
  newEmployeeType EmployeeType? @relation("EmployeeWorkHistoryNewEmployeeType", fields: [newEmployeeTypeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([type])
  @@index([effectiveDate])
  @@index([createdById])
  @@map("employee_work_histories")
}

/// ใบโยกย้าย/ปรับตำแหน่งที่ตั้งวันที่มีผลไว้ล่วงหน้าได้
///
/// เดิมการย้ายสาขา/ตำแหน่งทำได้ทางเดียวคือเข้าไปแก้ทะเบียนพนักงานตรง ๆ
/// ซึ่งมีผลทันทีเสมอ ทั้งที่คำสั่งย้ายจริงออกล่วงหน้าเป็นสัปดาห์ ผลคือ HR ต้องจำ
/// แล้วกลับมาแก้เองในวันนั้น ถ้าลืมก็ไปโผล่ที่งวดเงินเดือนผิดสาขา
///
/// ค่า from* ถูกบันทึกไว้ตอนสร้างเพื่อให้หน้าจอแสดง "จาก → ไป" ได้ตั้งแต่ยังไม่ถึงวัน
/// และถูกเขียนทับด้วยค่าจริงอีกครั้งตอนมีผล เพราะข้อมูลพนักงานอาจเปลี่ยนระหว่างรอ
model EmployeeTransfer {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  status EmployeeTransferStatus @default(SCHEDULED)

  /// ชนิดของการเปลี่ยนแปลงหลัก ใช้เป็นชนิดของประวัติการทำงานที่จะถูกสร้างตอนมีผล
  type WorkHistoryType @default(OTHER)

  /// วันแรกที่ให้ถือว่าอยู่สังกัดใหม่ (เทียบแบบทั้งวันตามเวลาไทย)
  effectiveDate DateTime

  /// เลขที่คำสั่ง/บันทึกข้อความ ไว้อ้างอิงกับเอกสารตัวจริง
  documentNo String?
  reason     String?
  note       String?

  fromBranchId String?
  toBranchId   String?

  fromDepartmentId String?
  toDepartmentId   String?

  fromDivisionId String?
  toDivisionId   String?

  fromPositionId String?
  toPositionId   String?

  /// ชื่อตำแหน่งแบบข้อความ สำหรับบริษัทที่ยังไม่ได้ผูกตำแหน่งกับทะเบียนตำแหน่ง
  fromPositionTitle String?
  toPositionTitle   String?

  fromEmployeeTypeId String?
  toEmployeeTypeId   String?

  fromSupervisorId String?
  toSupervisorId   String?

  appliedAt     DateTime?
  workHistoryId String?   @unique

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy   User? @relation("EmployeeTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("EmployeeTransferCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  fromBranch Branch? @relation("EmployeeTransferFromBranch", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranch   Branch? @relation("EmployeeTransferToBranch", fields: [toBranchId], references: [id], onDelete: SetNull)

  fromDepartment Department? @relation("EmployeeTransferFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartment   Department? @relation("EmployeeTransferToDepartment", fields: [toDepartmentId], references: [id], onDelete: SetNull)

  fromDivision Division? @relation("EmployeeTransferFromDivision", fields: [fromDivisionId], references: [id], onDelete: SetNull)
  toDivision   Division? @relation("EmployeeTransferToDivision", fields: [toDivisionId], references: [id], onDelete: SetNull)

  fromPosition Position? @relation("EmployeeTransferFromPosition", fields: [fromPositionId], references: [id], onDelete: SetNull)
  toPosition   Position? @relation("EmployeeTransferToPosition", fields: [toPositionId], references: [id], onDelete: SetNull)

  fromEmployeeType EmployeeType? @relation("EmployeeTransferFromEmployeeType", fields: [fromEmployeeTypeId], references: [id], onDelete: SetNull)
  toEmployeeType   EmployeeType? @relation("EmployeeTransferToEmployeeType", fields: [toEmployeeTypeId], references: [id], onDelete: SetNull)

  fromSupervisor Employee? @relation("EmployeeTransferFromSupervisor", fields: [fromSupervisorId], references: [id], onDelete: SetNull)
  toSupervisor   Employee? @relation("EmployeeTransferToSupervisor", fields: [toSupervisorId], references: [id], onDelete: SetNull)

  @@index([companyId, status, effectiveDate])
  @@index([employeeId, effectiveDate])
  @@index([status, effectiveDate])
  @@map("employee_transfers")
}

model EmployeeResignation {
  id         String @id @default(cuid())
  employeeId String

  resignationDate DateTime
  effectiveDate   DateTime
  reason          String
  note            String?
  status          ResignationStatus @default(DRAFT)

  documentId String?

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  submittedById String?
  approvedById  String?
  rejectedById  String?
  cancelledById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  submittedBy User? @relation("EmployeeResignationSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy  User? @relation("EmployeeResignationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User? @relation("EmployeeResignationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("EmployeeResignationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

