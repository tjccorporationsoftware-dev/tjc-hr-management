  reportJob  ReportJob?  @relation(fields: [reportJobId], references: [id], onDelete: SetNull)
  exportFile ExportFile? @relation(fields: [exportFileId], references: [id], onDelete: SetNull)

  createdBy User? @relation("ReportLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([reportJobId])
  @@index([exportFileId])
  @@index([reportCode])
  @@index([action])
  @@index([createdById])
  @@index([createdAt])
