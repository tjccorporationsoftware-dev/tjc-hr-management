  @@index([channel])
  @@index([status])
  @@index([source])
  @@index([session])
  @@index([rawScannerRecordId])
  @@index([offsiteRequestId])
  @@index([gpsVerificationStatus])
  @@index([deviceId])
  @@index([locationId])
  @@index([createdById])
  @@index([deletedAt])
