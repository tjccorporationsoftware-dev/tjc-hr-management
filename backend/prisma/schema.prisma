/// ผูกพนักงานกับรหัสผู้ใช้ในเครื่องสแกน
/// เครื่องสแกนส่งมาแค่ deviceUserId ต้องมีตารางนี้ถึงจะรู้ว่าเป็นพนักงานคนไหน
model AttendanceDeviceEnrollment {
  id String @id @default(cuid())

  deviceId   String
  employeeId String

  /// รหัสผู้ใช้ที่ลงทะเบียนไว้ในเครื่อง (enroll no.)
  deviceUserId String
  /// จำนวนนิ้วที่สแกนเก็บไว้ในเครื่อง
  fingerCount  Int?
  note         String?
  enrolledAt   DateTime?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// ห้ามซ้ำเฉพาะแถวที่ยังใช้อยู่ — ดัชนีตัวจริงเป็น partial unique index
  /// ที่สร้างด้วย SQL (attendance_device_enrollments_active_*_idx) เพราะ Prisma
  /// ประกาศเงื่อนไข WHERE ในสคีมาไม่ได้
  ///
  /// ถ้าเป็น unique ธรรมดา แถวที่ถูกลบแบบซอฟต์จะยังกินที่อยู่ พอผูกพนักงานคนเดิม
  /// หรือใช้รหัสในเครื่องเดิมซ้ำ ระบบจะขึ้น "ข้อมูลซ้ำ" ทั้งที่หน้าจอไม่เห็นแถวไหนเลย
  @@index([deviceId, deviceUserId])
  @@index([deviceId, employeeId])
  @@index([employeeId])
  @@index([status])
  @@index([deletedAt])
  @@map("attendance_device_enrollments")
}

/// คิวคำสั่งที่รอส่งลงเครื่องสแกน (โปรโตคอล ADMS)
///
/// ส่งตรงไปที่เครื่องไม่ได้ เครื่องเป็นฝ่ายมา poll เอาคำสั่งไปเอง (/iclock/getrequest)
/// แล้วรายงานผลกลับมาทีหลัง (/iclock/devicecmd) จึงต้องพักคำสั่งไว้ในตารางนี้
/// และเก็บผลไว้ให้คนสั่งรู้ว่าลงเครื่องสำเร็จจริงหรือไม่
model AttendanceDeviceCommand {
  id String @id @default(cuid())

  /// เลขลำดับที่ใส่ไปในคำสั่ง (C:<seq>:...) เฟิร์มแวร์อ่านช่อง ID เป็นตัวเลข
  /// ส่ง cuid ไปแล้วผลที่ตอบกลับมาแมปกับคำสั่งเดิมไม่ได้
  seq Int @unique @default(autoincrement())

  deviceId String

  /// คำสั่งดิบตามรูปแบบของ ADMS เช่น DATA UPDATE USERINFO PIN=1	Name=...
  command String
  /// ชนิดคำสั่งไว้แสดงให้คนอ่าน เช่น USERINFO (ส่งทะเบียนผู้ใช้), DELETE_USER
  kind    String @default("USERINFO")

  /// พนักงานที่คำสั่งนี้เกี่ยวข้อง (ถ้ามี) ไว้บอกว่าใครลงเครื่องสำเร็จแล้วบ้าง
  employeeId String?

  /// PENDING = รอเครื่องมาเอาไป, SENT = ส่งให้แล้วรอผล, DONE / FAILED = จบแล้ว
  status String @default("PENDING")

  returnCode   Int?
  errorMessage String?

  sentAt      DateTime?
  respondedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
  @@index([employeeId])
  @@index([createdAt])
  @@map("attendance_device_commands")
}

model AttendancePolicy {
  id String @id @default(cuid())

