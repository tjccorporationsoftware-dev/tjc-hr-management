model LeaveType {
  id        String @id @default(cuid())
  companyId String

  /// ผูกกับรายการมาตรฐานระดับระบบ (null = ประเภทลาที่บริษัทสร้างเอง)
  catalogId     String?
  referenceCode String?

  code        String
  nameTh      String
  nameEn      String?
  description String?

  isPaid             Boolean @default(true)
  requiresAttachment Boolean @default(false)
  allowHalfDay       Boolean @default(true)
  allowHourly        Boolean @default(false)

  deductQuota      Boolean @default(true)
  affectAttendance Boolean @default(true)
  affectPayroll    Boolean @default(true)

  minLeaveUnitMinutes    Int      @default(240)
  maxLeaveDaysPerRequest Decimal? @db.Decimal(8, 2)

  /// ต้องยื่นลาล่วงหน้าอย่างน้อยกี่วัน (0 = ไม่บังคับ)
  advanceNoticeDays Int @default(0)

  allowBackdated              Boolean @default(false)
  maxBackdatedDays            Int     @default(0)
  backdatedRequiresAttachment Boolean @default(false)
  backdatedRequiresHrApproval Boolean @default(true)

  allowNegativeBalance Boolean @default(false)
  negativeBalanceMode  String?

  /// เงื่อนไข "ห้ามลาเกินโควตา"
  enforceQuotaLimit Boolean @default(true)

  /// true = วันหยุดที่คร่อมอยู่ในช่วงลา ถูกนับเป็นวันลาด้วย (พฤติกรรมเดิมของระบบ)
  includeHoliday Boolean @default(true)
  includeWeekend Boolean @default(true)

  attachmentRequiredAfterDays Decimal? @db.Decimal(8, 2)

  /// จำนวนปีที่สะสมโควตา (คอลัมน์ "จำนวนปีสะสม")
  quotaAccrualYears Int                    @default(1)
  genderEligibility LeaveGenderEligibility @default(ALL)
  serviceStartBasis LeaveServiceStartBasis @default(HIRE_DATE)

  /// ต้องผ่านการบรรจุก่อนถึงจะยื่นลาประเภทนี้ได้หรือไม่
  ///
  /// แยกออกจาก serviceStartBasis โดยตั้งใจ — ของเดิมใช้ค่าเดียวทำสองหน้าที่
  /// คือทั้ง "นับอายุงานเพื่อคิดโควตา" และ "บล็อกไม่ให้ยื่น" ปนกัน
  /// HR ที่อยากให้ลาพักร้อนนับอายุงานจากวันบรรจุ จึงเผลอบล็อกลาป่วยไปด้วย
  /// โดยไม่มีอะไรเตือน ดู statutory-leave.util.ts ที่เป็นเพดานล่างตามกฎหมาย
  requireProbationPassed Boolean               @default(false)
  /// เงื่อนไข "เฉลี่ยโควตาในปี" (คิดโควตาตามสัดส่วนปีแรกที่เข้างาน)
  prorateFirstYear       Boolean               @default(false)
  roundingMode           LeaveRoundingMode     @default(NONE)
  quotaDisplayUnit       LeaveQuotaDisplayUnit @default(DAY)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  catalog LeaveTypeCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)

  policies                 LeavePolicy[]
  balances                 LeaveBalance[]
  requests                 LeaveRequest[]
  attendanceDailySummaries AttendanceDailySummary[]

  @@unique([companyId, code])
  @@index([companyId, catalogId])
  @@index([catalogId])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("leave_types")
}

model LeavePolicy {
