model EmployeeCompensation {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  effectiveDate DateTime  @db.Date
  endDate       DateTime? @db.Date

  /// ฐานของ baseSalary — ต่อเดือน / ต่อวัน / ต่อชั่วโมง
  ///
  /// ต้องมีคู่กับ baseSalary เสมอ เพราะเลข 500 อย่างเดียวบอกไม่ได้ว่าเป็น
  /// เงินเดือน 500 บาท หรือค่าแรงวันละ 500 บาท
  ///
  /// ก่อนมีฟิลด์นี้ระบบเหมาว่าทุกคนเป็นรายเดือนแล้วหารด้วย 30 เสมอ
  /// พนักงานรายวันค่าแรง 500/วัน จึงได้อัตรา OT ชั่วโมงละ 2.08 บาท
  /// แทนที่จะเป็น 62.50 บาท (ต่างกัน 30 เท่า)
  ///
  /// ค่าเริ่มต้น MONTHLY เพื่อให้ข้อมูลเดิมทั้งหมดคำนวณเหมือนเดิมทุกประการ
  salaryBasis SalaryBasis @default(MONTHLY)

  baseSalary         Decimal @default(0) @db.Decimal(14, 2)

  paymentMethod PayrollPaymentMethod @default(BANK_TRANSFER)

  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  socialSecurityEnabled Boolean @default(true)
  taxEnabled            Boolean @default(true)

  status                 MasterStatus @default(ACTIVE)
  approvalStatus         String       @default("DRAFT")
  approvedAt             DateTime?
  approvedById           String?
  changeReason           String?
  previousCompensationId String?
  policySnapshot         Json?

  note String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payrollItems PayrollItem[]

  @@unique([employeeId, effectiveDate])
  @@index([companyId])
  @@index([effectiveDate])
  @@index([endDate])
  @@index([status])
  @@index([approvalStatus])
  @@index([approvedById])
  @@index([previousCompensationId])
  @@index([deletedAt])
  @@map("employee_compensations")
}

model PayrollPeriod {
  id        String @id @default(cuid())
  companyId String

  code String
  name String

  year  Int
  month Int

  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  paymentDate DateTime @db.Date

  status PayrollPeriodStatus @default(DRAFT)

  lockedAt    DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("PayrollPeriodCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  runs PayrollRun[]

  /// รหัสห้ามซ้ำเฉพาะงวดที่ยังอยู่ — ดัชนีตัวจริงเป็น partial unique index
  /// (payroll_periods_active_code_idx) ที่สร้างด้วย SQL เพราะ Prisma ประกาศ
  /// เงื่อนไข WHERE ในสคีมาไม่ได้ · งวดที่ถูกยกเลิกไปแล้วต้องไม่จองรหัสค้างไว้
  /// ไม่งั้นลบงวดที่สร้างผิดแล้วสร้างใหม่ด้วยรหัสเดิมไม่ได้
  @@index([companyId, code])
  @@index([year, month])
  @@index([startDate])
  @@index([endDate])
  @@index([paymentDate])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("payroll_periods")
}

model PayrollRun {
  id        String @id @default(cuid())
  companyId String
  periodId  String

  runNo String
  name  String?

  status PayrollRunStatus @default(DRAFT)

  /// สาขาที่รอบนี้ครอบคลุม — ว่าง = ทั้งบริษัท (พฤติกรรมเดิมก่อนมีฟิลด์นี้)
  /// เก็บเป็น id ไม่ใช่ relation เพราะเป็นภาพนิ่งของตอนสร้างรอบ
  /// ถ้าภายหลังลบสาขาทิ้ง รอบเก่าต้องยังบอกได้ว่าตอนนั้นคำนวณให้ใครบ้าง
  branchIds String[] @default([])

  totalEmployees  Int     @default(0)
  totalEarnings   Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalGrossPay   Decimal @default(0) @db.Decimal(14, 2)
  totalNetPay     Decimal @default(0) @db.Decimal(14, 2)

  calculatedAt DateTime?
  reviewedAt   DateTime?
  approvedAt   DateTime?
  paidAt       DateTime?
  cancelledAt  DateTime?

  createdById    String?
  calculatedById String?
  // ต้องเก็บผู้ตรวจไว้ เพราะผู้อนุมัติต้องไม่ใช่คนเดียวกัน (แยกหน้าที่ในขั้นจ่ายเงิน)
  reviewedById   String?
  approvedById   String?
  paidById       String?
  cancelledById  String?

  payslipsPublishedAt     DateTime?
  payslipsPublishedById   String?
  payslipsUnpublishedAt   DateTime?
  payslipsUnpublishedById String?

  payslipDetailsVisible               Boolean   @default(true)
  payslipDetailsVisibilityUpdatedAt   DateTime?
  payslipDetailsVisibilityUpdatedById String?

  note                   String?
  errorMessage           String?
  payrollSettingSnapshot Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period  PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  createdBy    User? @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  calculatedBy User? @relation("PayrollRunCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  reviewedBy   User? @relation("PayrollRunReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy   User? @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy       User? @relation("PayrollRunPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  cancelledBy  User? @relation("PayrollRunCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  items                PayrollItem[]
  taxCalculations      PayrollTaxCalculation[]
  deductionPlanEntries EmployeeDeductionPlanEntry[]

  @@unique([periodId, runNo])
  @@index([companyId])
  @@index([status])
  @@index([calculatedAt])
  @@index([approvedAt])
  @@index([paidAt])
  @@index([payslipsPublishedAt])
  @@index([payslipsPublishedById])
  @@index([payslipsUnpublishedAt])
  @@index([payslipDetailsVisibilityUpdatedById])
  @@index([createdById])
  @@index([deletedAt])
  @@map("payroll_runs")
}

model PayrollItem {
  id         String @id @default(cuid())
  runId      String
  employeeId String

  compensationId String?

  status PayrollItemStatus @default(DRAFT)

  baseSalary      Decimal @default(0) @db.Decimal(14, 2)
  totalEarnings   Decimal @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @db.Decimal(14, 2)
  totalGrossPay   Decimal @default(0) @db.Decimal(14, 2)
  totalNetPay     Decimal @default(0) @db.Decimal(14, 2)

  workingDays     Decimal @default(0) @db.Decimal(8, 2)
  paidLeaveDays   Decimal @default(0) @db.Decimal(8, 2)
  unpaidLeaveDays Decimal @default(0) @db.Decimal(8, 2)
  absentDays      Decimal @default(0) @db.Decimal(8, 2)
  lateMinutes     Int     @default(0)
  overtimeHours   Decimal @default(0) @db.Decimal(8, 2)

  // Snapshot องค์กร ณ วันที่คำนวณเงินเดือน ใช้สำหรับสรุปยอดย้อนหลังแยกสาขา/แผนก
  branchId       String?
  branchCode     String?
  branchName     String?
  departmentId   String?
  departmentCode String?
  departmentName String?

  snapshot Json?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run          PayrollRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  compensation EmployeeCompensation? @relation(fields: [compensationId], references: [id], onDelete: SetNull)

  lines          PayrollLine[]
  taxCalculation PayrollTaxCalculation?

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([compensationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([status])
  @@map("payroll_items")
}

model PayrollLine {
  id            String  @id @default(cuid())
  payrollItemId String
  componentId   String?

  code String
  name String

  type       PayrollLineType
  sourceType PayrollLineSourceType @default(MANUAL)
  sourceId   String?

  quantity Decimal? @db.Decimal(14, 4)
  rate     Decimal? @db.Decimal(14, 4)
  amount   Decimal  @default(0) @db.Decimal(14, 2)

  isTaxable            Boolean @default(true)
  isSocialSecurityBase Boolean @default(false)

  sortOrder Int     @default(0)
  note      String?

  createdAt DateTime @default(now())

  payrollItem PayrollItem       @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  component   PayrollComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payrollItemId])
  @@index([componentId])
  @@index([code])
  @@index([type])
  @@index([sourceType])
  @@index([sourceId])
  @@map("payroll_lines")
}

// =========================================================
// PAYROLL TAX FULL SYSTEM - PHASE 1A
// =========================================================
// วางฐานข้อมูลสำหรับระบบภาษีหัก ณ ที่จ่ายแบบเต็มรูปแบบ
// Phase นี้ยังไม่คำนวณภาษีจริงใน Payroll Run แต่เตรียมข้อมูลสำหรับ Tax Engine Phase ถัดไป

model PayrollTaxYear {
  id        String @id @default(cuid())
  companyId String

  taxYear Int
  code    String
  name    String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  personalExpenseRate       Decimal @default(0.50) @db.Decimal(8, 4)
  personalExpenseMax        Decimal @default(100000) @db.Decimal(14, 2)
  standardPersonalAllowance Decimal @default(60000) @db.Decimal(14, 2)

  roundingMethod     String @default("ROUND_TO_BAHT")
  taxAveragingMethod String @default("ANNUALIZED_REMAINING_PERIODS")

  isActive Boolean      @default(true)
  status   MasterStatus @default(ACTIVE)
  note     String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  brackets             PayrollTaxBracket[]
  allowanceTypes       PayrollTaxAllowanceType[]
  allowanceLimitGroups PayrollTaxAllowanceLimitGroup[]
  profiles             EmployeeTaxProfile[]
  yearSummaries        EmployeeTaxYearSummary[]
  calculations         PayrollTaxCalculation[]

  @@unique([companyId, taxYear])
  @@index([taxYear])
  @@index([status])
  @@index([deletedAt])
  @@map("payroll_tax_years")
}

model PayrollTaxBracket {
  id        String @id @default(cuid())
  taxYearId String

  minIncome Decimal  @db.Decimal(14, 2)
  maxIncome Decimal? @db.Decimal(14, 2)
  rate      Decimal  @db.Decimal(8, 4)

  quickDeduction Decimal @default(0) @db.Decimal(14, 2)
  sortOrder      Int     @default(0)
  note           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  taxYear PayrollTaxYear @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@unique([taxYearId, sortOrder])
  @@index([minIncome])
  @@index([maxIncome])
  @@index([deletedAt])
  @@map("payroll_tax_brackets")
}

model PayrollTaxAllowanceType {
  id        String @id @default(cuid())
  taxYearId String

  code        String
  nameTh      String
  nameEn      String?
  description String?
  category    String  @default("GENERAL")

  defaultAmount Decimal  @default(0) @db.Decimal(14, 2)
  maxAmount     Decimal? @db.Decimal(14, 2)

  /// เพดานเป็นสัดส่วนของเงินได้ (0.15 = 15%) — ว่างคือไม่จำกัดด้วยสัดส่วน
  maxPercentOfIncome  Decimal? @db.Decimal(8, 4)
  /// ฐานที่ใช้คิดสัดส่วน: GROSS_INCOME | NET_AFTER_ALLOWANCE (เงินบริจาคใช้แบบหลัง)
  percentBase         String   @default("GROSS_INCOME")
  /// ตัวคูณยอดที่หักได้ เช่น บริจาคเพื่อการศึกษาหักได้ 2 เท่าของที่จ่ายจริง
  deductionMultiplier Decimal  @default(1) @db.Decimal(8, 4)
  /// รหัสกลุ่มเพดานรวม เช่น กองทุนเกษียณที่รวมกันไม่เกิน 500,000
  limitGroupCode      String?

  isSystem           Boolean      @default(false)
  requiresAttachment Boolean      @default(false)
  sortOrder          Int          @default(0)
  status             MasterStatus @default(ACTIVE)
  note               String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  taxYear    PayrollTaxYear         @relation(fields: [taxYearId], references: [id], onDelete: Cascade)
  allowances EmployeeTaxAllowance[]

  @@unique([taxYearId, code])
  @@index([code])
  @@index([category])
  @@index([status])
  @@index([limitGroupCode])
  @@index([deletedAt])
  @@map("payroll_tax_allowance_types")
}

/// กลุ่มเพดานค่าลดหย่อนรวม — ใช้กับกฎที่จำกัดหลายประเภทรวมกัน
/// เช่น PVD + กบข. + RMF + SSF + กอช. + ประกันบำนาญ รวมกันไม่เกิน 500,000
model PayrollTaxAllowanceLimitGroup {
  id        String @id @default(cuid())
  taxYearId String

  code   String
  nameTh String
  nameEn String?

  /// เพดานรวมเป็นจำนวนเงิน — ว่างคือไม่จำกัดด้วยจำนวนเงิน
  maxAmount          Decimal? @db.Decimal(14, 2)
  /// เพดานรวมเป็นสัดส่วนของฐาน (0.10 = 10%)
  maxPercentOfIncome Decimal? @db.Decimal(8, 4)
  percentBase        String   @default("GROSS_INCOME")

  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)
  status    MasterStatus @default(ACTIVE)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  taxYear PayrollTaxYear @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@unique([taxYearId, code])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("payroll_tax_allowance_limit_groups")
}

/// สมาชิกครอบครัวของพนักงาน
///
/// เดิมเก็บได้แค่ "ผู้ติดต่อฉุกเฉิน" 2 ชุดในแฟ้มพนักงาน ซึ่งไม่พอกับทะเบียนจริง
/// ที่มีทั้ง บิดา มารดา คู่สมรส และพี่น้อง หลายคนต่อพนักงานหนึ่งคน
///
/// ใช้สำหรับติดต่อกรณีฉุกเฉินและงานสวัสดิการ ไม่ได้ใช้คำนวณลดหย่อนภาษี
/// (ส่วนนั้นอยู่ที่ EmployeeTaxAllowance ซึ่งต้องมีหลักฐานประกอบแยกต่างหาก)
model EmployeeFamilyMember {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  name String
  /// ความสัมพันธ์ตามที่ทะเบียนต้นทางระบุ เช่น บิดา มารดา สามี ภรรยา พี่น้อง
  relation  String?
  birthDate DateTime?
  phone     String?
  address   String?
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("employee_family_members")
}

/// ประวัติการศึกษาของพนักงาน (หนึ่งคนมีได้หลายวุฒิ)
///
/// แฟ้มพนักงานมีช่องการศึกษาชุดเดียว (educationLevel/Institute/Major) ซึ่งเก็บได้
/// แค่วุฒิสูงสุด ตารางนี้เก็บครบทุกใบตามทะเบียนต้นทาง ส่วนช่องเดิมยังคงไว้
/// เพราะแอปมือถือกับเอกสารที่ออกให้พนักงานดึงไปใช้อยู่
model EmployeeEducation {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  /// ระดับการศึกษาตามที่ทะเบียนต้นทางระบุ เช่น ปริญญาตรี ปวส. มัธยมศึกษา
  level     String
  institute String?
  major     String?
  /// ปีการศึกษาที่จบ (ค.ศ.) — ต้นทางใส่ 0 มาเมื่อไม่ทราบ จะเก็บเป็น null
  gradYear  Int?
  gpa       Decimal? @db.Decimal(4, 2)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("employee_educations")
}

model EmployeeTaxProfile {
  id         String @id @default(cuid())
  companyId  String
  employeeId String
  taxYearId  String

  taxEnabled Boolean @default(true)
  taxId      String?

  maritalStatus   String?
  spouseHasIncome Boolean @default(false)

  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxYear  PayrollTaxYear @relation(fields: [taxYearId], references: [id], onDelete: Restrict)

  allowances    EmployeeTaxAllowance[]
  yearSummaries EmployeeTaxYearSummary[]
  calculations  PayrollTaxCalculation[]

  @@unique([employeeId, taxYearId])
  @@index([companyId])
  @@index([taxYearId])
  @@index([deletedAt])
  @@map("employee_tax_profiles")
}

model EmployeeTaxAllowance {
  id              String @id @default(cuid())
  taxProfileId    String
  allowanceTypeId String

  /// ยอดที่ลูกจ้างแจ้งไว้ตาม ล.ย.01 — ใช้คำนวณโดยตรง ไม่มีขั้นอนุมัติ
  declaredAmount Decimal @default(0) @db.Decimal(14, 2)

  note          String?
  attachmentUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  taxProfile    EmployeeTaxProfile      @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)
  allowanceType PayrollTaxAllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)

  @@unique([taxProfileId, allowanceTypeId])
  @@index([allowanceTypeId])
  @@index([deletedAt])
  @@map("employee_tax_allowances")
}

model EmployeeTaxYearSummary {
  id           String  @id @default(cuid())
  companyId    String
  employeeId   String
  taxYearId    String
  taxProfileId String?

  totalTaxableIncome  Decimal @default(0) @db.Decimal(14, 2)
  totalTaxWithheld    Decimal @default(0) @db.Decimal(14, 2)
  totalSocialSecurity Decimal @default(0) @db.Decimal(14, 2)
  totalAllowance      Decimal @default(0) @db.Decimal(14, 2)
  totalTaxPayable     Decimal @default(0) @db.Decimal(14, 2)

  lastCalculatedAt DateTime?
  snapshot         Json?
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxYear    PayrollTaxYear      @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  taxProfile EmployeeTaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)

  @@unique([employeeId, taxYearId])
  @@index([companyId])
  @@index([taxYearId])
  @@index([taxProfileId])
  @@index([lastCalculatedAt])
  @@map("employee_tax_year_summaries")
}

model PayrollTaxCalculation {
  id            String  @id @default(cuid())
  companyId     String
  payrollRunId  String
  payrollItemId String
  employeeId    String
  taxYearId     String
  taxProfileId  String?

  taxableIncomeCurrentRun Decimal @default(0) @db.Decimal(14, 2)
  projectedAnnualIncome   Decimal @default(0) @db.Decimal(14, 2)
  expenseDeduction        Decimal @default(0) @db.Decimal(14, 2)
  allowanceTotal          Decimal @default(0) @db.Decimal(14, 2)
  netTaxableIncome        Decimal @default(0) @db.Decimal(14, 2)
  annualTax               Decimal @default(0) @db.Decimal(14, 2)
  taxWithheldYtd          Decimal @default(0) @db.Decimal(14, 2)
  remainingTax            Decimal @default(0) @db.Decimal(14, 2)
  currentRunTax           Decimal @default(0) @db.Decimal(14, 2)
  roundingAdjustment      Decimal @default(0) @db.Decimal(14, 2)

  status              PayrollTaxCalculationStatus @default(CALCULATED)
  calculationSnapshot Json?
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRun  PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollItem PayrollItem         @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxYear     PayrollTaxYear      @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  taxProfile  EmployeeTaxProfile? @relation(fields: [taxProfileId], references: [id], onDelete: SetNull)

  @@unique([payrollItemId])
  @@index([companyId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([taxYearId])
  @@index([taxProfileId])
  @@index([status])
  @@map("payroll_tax_calculations")
}

// =========================================================
// HR REVIEW / PAYROLL HANDOFF
// =========================================================
// ตารางนี้ใช้เก็บสถานะหลังจากคำขอ Leave / OT / Time Adjust อนุมัติครบแล้ว
// เป้าหมายคือให้ HR ตรวจสอบก่อนส่งรายการเข้า Payroll
// หมายเหตุ: Phase นี้ยังไม่สร้าง PayrollLine จริงทันที เพื่อไม่กระทบ flow Payroll เดิม

enum HrReviewSourceType {
  LEAVE
  OVERTIME
  TIME_ADJUST
}

enum HrReviewStatus {
  REVIEWED
  PAYROLL_READY
  ON_HOLD
  SENT_TO_PAYROLL
  CANCELLED
}

model HrReviewItem {
  id String @id @default(cuid())

  // Source คือรายการต้นทางที่อนุมัติครบแล้ว เช่น LeaveRequest / OvertimeRequest / TimeAdjustRequest
  sourceType HrReviewSourceType
  sourceId   String

  // เก็บ companyId / employeeId ซ้ำไว้เพื่อ query เร็ว และลดการ join ตอนดูรายงาน
  companyId  String
  employeeId String

  // ถ้ารายการนี้ผูกกับงวดเงินเดือนหรือ Payroll Run แล้ว ให้เก็บ id ไว้ตรงนี้
  periodId     String?
  payrollRunId String?

  status HrReviewStatus @default(REVIEWED)

  reviewedAt   DateTime?
  reviewedById String?

  payrollReadyAt   DateTime?
  payrollReadyById String?

  sentToPayrollAt   DateTime?
  sentToPayrollById String?

  heldAt   DateTime?
  heldById String?

  cancelledAt   DateTime?
  cancelledById String?

  reason String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceId])
  @@index([companyId])
  @@index([employeeId])
  @@index([periodId])
  @@index([payrollRunId])
  @@index([status])
  @@index([reviewedById])
  @@index([payrollReadyById])
  @@index([sentToPayrollById])
  @@index([createdAt])
  @@map("hr_review_items")
}

// =========================================================
// PAYROLL EXTENSIONS: RECURRING ITEMS / ADJUSTMENTS / ATTENDANCE DEDUCTIONS
// =========================================================
// Phase 13-17 ใช้สำหรับรองรับรายการรายรับ/รายหักที่มากกว่าเงินเดือนพื้นฐาน
// เช่น ค่าเดินทาง ค่าโทรศัพท์ โบนัส หักมาสาย หักขาดงาน หักเงินยืม ฯลฯ
// หมายเหตุ: โมเดลกลุ่มนี้ไม่เปลี่ยน PayrollLine เดิม แต่เป็นแหล่งข้อมูลก่อนคำนวณ Payroll Run

enum PayrollAdjustmentStatus {
  DRAFT
  APPROVED
  CANCELLED
  IMPORTED
}

enum AttendancePayrollRuleKind {
  LATE
  EARLY_LEAVE
  MISSING_CHECK_IN
  MISSING_CHECK_OUT
  ABSENCE
}

enum AttendancePayrollDeductionUnit {
  FIXED
  PER_OCCURRENCE
  PER_MINUTE
  PER_HOUR
  PER_DAY
}

model EmployeeCompensationItem {
  id String @id @default(cuid())

  companyId  String
  employeeId String

  // ถ้าผูกกับ compensation record เฉพาะช่วง ให้ใส่ compensationId ได้
  // แต่ไม่บังคับ เพื่อให้ใช้กับค่า recurring ที่กำหนดตรงกับพนักงานได้ง่าย
  compensationId String?
  componentId    String?

  code String
  name String

  type       PayrollLineType
  sourceType PayrollLineSourceType @default(ALLOWANCE)

  quantity Decimal @default(1) @db.Decimal(14, 4)
  rate     Decimal @default(0) @db.Decimal(14, 4)
  amount   Decimal @default(0) @db.Decimal(14, 2)

  effectiveDate DateTime  @db.Date
  endDate       DateTime? @db.Date

  isTaxable            Boolean @default(true)
  isSocialSecurityBase Boolean @default(false)

  /// คิดตามสัดส่วนวันที่เป็นพนักงานจริงในงวดหรือไม่ (เข้าใหม่ / ลาออกกลางงวด)
  ///
  /// true  = ค่าอาหาร ค่าเดินทาง ค่าตำแหน่ง — เข้าวันที่ 16 ได้ครึ่งเดียว
  /// false = ประกันกลุ่มรายเดือน ค่าผ่อนชำระงวดคงที่ — จ่าย/หักเต็มจำนวนเสมอ
  ///
  /// ค่าเริ่มต้นเป็น true เพราะรายการประจำส่วนใหญ่ควรหารตามวัน
  /// การจ่ายเกินกู้คืนยากกว่าการจ่ายขาด จึงให้ฝั่งที่ปลอดภัยกว่าเป็นค่าเริ่มต้น
  prorateByEmploymentDays Boolean @default(true)

  sortOrder Int          @default(100)
  status    MasterStatus @default(ACTIVE)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([employeeId])
  @@index([compensationId])
  @@index([componentId])
  @@index([code])
  @@index([type])
  @@index([sourceType])
  @@index([effectiveDate])
  @@index([endDate])
  @@index([status])
  @@index([deletedAt])
  @@map("employee_compensation_items")
}

/// แผนหักเงินเดือนแบบผ่อนงวด — กยศ. เงินกู้พนักงาน สหกรณ์
///
/// ต่างจาก PayrollAdjustment ตรงที่ตัวนี้มี "ยอดคงเหลือ" และหักอัตโนมัติทุกงวดจนครบ
/// ส่วน PayrollAdjustment เป็นรายการครั้งเดียวเฉพาะงวด
model EmployeeDeductionPlan {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  planType EmployeeDeductionPlanType
  code     String
  name     String

  /// เลขที่สัญญา / เลขที่ผู้กู้ ใช้อ้างอิงตอนนำส่ง
  referenceNo String?

  /// ยอดหนี้ทั้งหมด — เว้นว่าง = หักไปเรื่อย ๆ จนกว่าจะสั่งหยุด
  totalAmount       Decimal? @db.Decimal(14, 2)
  /// จำนวนที่หักต่องวด
  installmentAmount Decimal  @db.Decimal(14, 2)
  /// ยอดที่หักไปแล้วสะสม
  paidAmount        Decimal  @default(0) @db.Decimal(14, 2)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  /// ลำดับการหักเมื่อเงินเดือนไม่พอหักทุกรายการ (เลขน้อยหักก่อน)
  priority Int @default(100)

  /// true = ถ้าเงินเหลือไม่พอ ให้หักเท่าที่หักได้ / false = ข้ามงวดนั้นไปเลย
  allowPartialDeduction Boolean @default(true)

  status EmployeeDeductionPlanStatus @default(ACTIVE)
  note   String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  entries EmployeeDeductionPlanEntry[]

  @@index([companyId])
  @@index([employeeId])
  @@index([planType])
  @@index([status])
  @@index([startDate])
  @@index([priority])
  @@index([deletedAt])
  @@map("employee_deduction_plans")
}

/// ประวัติการหักรายงวดของแผน ใช้ตรวจย้อนหลังและกันหักซ้ำเมื่อคำนวณ payroll ใหม่
model EmployeeDeductionPlanEntry {
  id     String @id @default(cuid())
  planId String

  payrollRunId  String
  payrollItemId String?

  amount        Decimal @db.Decimal(14, 2)
  balanceBefore Decimal @db.Decimal(14, 2)
  balanceAfter  Decimal @db.Decimal(14, 2)

  /// true = หักได้ไม่เต็มงวดเพราะเงินเหลือไม่พอ
  isPartial Boolean @default(false)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan       EmployeeDeductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun            @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@unique([planId, payrollRunId])
  @@index([payrollRunId])
  @@index([payrollItemId])
  @@map("employee_deduction_plan_entries")
}

model PayrollAdjustment {
  id String @id @default(cuid())

  companyId  String
  employeeId String

  // ถ้าผูกกับงวดเงินเดือนโดยตรง ให้ใส่ periodId
  // ถ้ายังไม่ผูกงวด ระบบจะดู effectiveDate ว่าอยู่ในช่วง Payroll Period หรือไม่
  periodId     String?
  payrollRunId String?
  componentId  String?

  code String
  name String

  type       PayrollLineType
  sourceType PayrollLineSourceType @default(ADJUSTMENT)

  quantity Decimal @default(1) @db.Decimal(14, 4)
  rate     Decimal @default(0) @db.Decimal(14, 4)
  amount   Decimal @default(0) @db.Decimal(14, 2)

  effectiveDate DateTime? @db.Date

  isTaxable            Boolean @default(true)
  isSocialSecurityBase Boolean @default(false)

  status PayrollAdjustmentStatus @default(DRAFT)

  approvedAt   DateTime?
  approvedById String?

  importedAt   DateTime?
  importedById String?

  cancelledAt   DateTime?
  cancelledById String?

  reason String?
  note   String?

  sortOrder Int @default(500)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([companyId])
  @@index([employeeId])
  @@index([periodId])
  @@index([payrollRunId])
  @@index([componentId])
  @@index([code])
  @@index([type])
  @@index([sourceType])
  @@index([effectiveDate])
  @@index([status])
  @@index([approvedById])
  @@index([importedById])
  @@index([createdById])
  @@index([deletedAt])
  @@map("payroll_adjustments")
}

model AttendancePayrollRule {
  id String @id @default(cuid())

  companyId String

  code        String
  name        String
  description String?

  kind AttendancePayrollRuleKind
  unit AttendancePayrollDeductionUnit @default(PER_OCCURRENCE)

  componentId   String?
  componentCode String?

  // ถ้า useSalaryRate = true ระบบจะคำนวณจากฐานเงินเดือน เช่น daily/hourly rate
  // ถ้า false จะใช้ rateAmount เป็นอัตราหักโดยตรง
  useSalaryRate Boolean  @default(true)
  rateAmount    Decimal? @db.Decimal(14, 4)

  graceMinutes       Int     @default(0)
  salaryDivisorDays  Decimal @default(30) @db.Decimal(8, 2)
  salaryDivisorHours Decimal @default(8) @db.Decimal(8, 2)

  maxDeductionAmount Decimal? @db.Decimal(14, 2)

  isTaxable            Boolean @default(false)
  isSocialSecurityBase Boolean @default(false)

  sortOrder Int          @default(600)
  status    MasterStatus @default(ACTIVE)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([kind])
  @@index([unit])
  @@index([componentId])
  @@index([componentCode])
  @@index([status])
  @@index([deletedAt])
  @@map("attendance_payroll_rules")
}

/**
 * ==========================================================
 * OFFBOARDING — กระบวนการพนักงานออกจากงาน
 * ----------------------------------------------------------
 * ต่อจาก EmployeeResignation ที่อนุมัติแล้ว
 * คุมการคืนของ ปิดสิทธิ์ ส่งมอบงาน สัมภาษณ์ลาออก และเงินงวดสุดท้าย
 * ==========================================================
 */

/// สถานะเคสการออกจากงาน
enum OffboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// ผลของงานคืนของ/ส่งมอบแต่ละรายการ
enum OffboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  WAIVED
  CANCELLED
}

/// เหตุผลที่พ้นสภาพ ใช้แยกสิทธิ์ค่าชดเชยตามกฎหมาย
enum OffboardingReasonType {
  RESIGNATION
  TERMINATION
  END_OF_CONTRACT
  RETIREMENT
  LAYOFF
  OTHER
}

/// แม่แบบรายการที่ต้องเคลียร์ก่อนออก ใช้ซ้ำได้ทุกคน
model OffboardingChecklist {
  id        String  @id @default(cuid())
  companyId String?

  code        String
  name        String
  description String?

  status MasterStatus @default(ACTIVE)

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("OffboardingChecklistCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items OffboardingChecklistItem[]
  cases OffboardingCase[]

  @@unique([companyId, code])
  @@index([status])
  @@index([deletedAt])
  @@map("offboarding_checklists")
}

model OffboardingChecklistItem {
  id          String @id @default(cuid())
  checklistId String

  title       String
  description String?
  /// หมวด เช่น อุปกรณ์ / สิทธิ์ระบบ / ส่งมอบงาน / การเงิน
  category    String?
  /// แผนกที่รับผิดชอบตรวจรับ เช่น IT, บัญชี, หัวหน้างาน
  ownerRole   String?

  sortOrder  Int     @default(0)
  isRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist OffboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  tasks     OffboardingTask[]

  @@index([checklistId])
  @@index([sortOrder])
  @@map("offboarding_checklist_items")
}

/// เคสการออกจากงาน 1 ใบต่อการออก 1 ครั้ง
model OffboardingCase {
  id String @id @default(cuid())

  companyId  String
  employeeId String

  /// ใบลาออกที่เป็นต้นเรื่อง (ถ้าเป็นการเลิกจ้างจะไม่มี)
  resignationId String? @unique

  checklistId String?

  reasonType      OffboardingReasonType @default(RESIGNATION)
  lastWorkingDate DateTime
  /// วันพ้นสภาพพนักงาน ใช้เป็นวันปิดสิทธิ์เข้าระบบ
  effectiveDate   DateTime

  status OffboardingStatus @default(IN_PROGRESS)

  /// ปิดสิทธิ์เข้าใช้ระบบแล้วหรือยัง
  accessRevokedAt          DateTime?
  /// กันไม่ให้ถูกดึงเข้างวดเงินเดือนถัดไป
  payrollStoppedAt         DateTime?
  /// แจ้งออกประกันสังคม (สปส. 6-09)
  socialSecurityNotifiedAt DateTime?

  /// วันลาคงเหลือที่จ่ายเป็นเงิน
  unusedLeaveDays Decimal? @db.Decimal(10, 2)
  /// ค่าชดเชยตามกฎหมาย — ระบบคำนวณให้จากบันไดอายุงาน แก้ทับได้
  severancePay    Decimal? @db.Decimal(14, 2)
  finalPayNote    String?

  /// เลิกจ้างเพราะลูกจ้างกระทำผิดร้ายแรง (มาตรา 119) — ถ้าใช่ ไม่ได้ค่าชดเชย
  terminatedWithCause  Boolean  @default(false)
  /// จำนวนวันค่าจ้างแทนการบอกกล่าวล่วงหน้า (มาตรา 17)
  noticePayDays        Decimal? @db.Decimal(10, 2)
  /// ค่าชดเชยพิเศษ กรณีย้ายสถานประกอบกิจการหรือใช้เครื่องจักรแทนคน
  specialSeveranceDays Decimal? @db.Decimal(10, 2)
  /// เงินก้อนอื่นที่ตกลงจ่ายเพิ่มตอนออกจากงาน
  otherSeparationPay   Decimal? @db.Decimal(14, 2)

  /// ผลคำนวณเต็มรูปแบบ (รายการ + ภาษี) เก็บไว้เป็นหลักฐานว่าตอนนั้นคิดจากอะไร
  severanceBreakdown    Json?
  severanceCalculatedAt DateTime?

  note        String?
  completedAt DateTime?
  cancelledAt DateTime?

  createdById   String?
  completedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resignation EmployeeResignation?  @relation(fields: [resignationId], references: [id], onDelete: SetNull)
  checklist   OffboardingChecklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  createdBy   User? @relation("OffboardingCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User? @relation("OffboardingCaseCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  tasks         OffboardingTask[]
  exitInterview ExitInterview?

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([effectiveDate])
  @@index([deletedAt])
  @@map("offboarding_cases")
}

/// รายการคืนของ/ส่งมอบ/ปิดสิทธิ์ รายคน
model OffboardingTask {
  id String @id @default(cuid())

  companyId  String
  employeeId String
  caseId     String

  checklistItemId String?

  title       String
  description String?
  category    String?
  ownerRole   String?

  status OffboardingTaskStatus @default(PENDING)

  dueDate     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  note        String?

  isRequired Boolean @default(true)

  completedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  case          OffboardingCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  checklistItem OffboardingChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  completedBy User? @relation("OffboardingTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([caseId])
  @@index([status])
  @@index([deletedAt])
  @@map("offboarding_tasks")
}

/// บันทึกสัมภาษณ์ลาออก ใช้วิเคราะห์สาเหตุการลาออก
model ExitInterview {
  id     String @id @default(cuid())
  caseId String @unique

  interviewDate DateTime?
  interviewerId String?

  /// เหตุผลหลักที่ลาออก เช่น ค่าตอบแทน / หัวหน้างาน / ความก้าวหน้า
  primaryReason  String?
  /// 0-10 แนะนำองค์กรให้คนอื่นไหม
  recommendScore Int?
  wouldRehire    Boolean?

  whatWorkedWell String?
  whatToImprove  String?
  note           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  case        OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  interviewer User?           @relation("ExitInterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([interviewDate])
  @@index([deletedAt])
  @@map("exit_interviews")
}

/**
 * ==========================================================
 * RECRUITMENT / ATS — สรรหาและคัดเลือกพนักงาน
 * ----------------------------------------------------------
 * ต้นทางของ lifecycle: ประกาศงาน -> ผู้สมัคร -> สัมภาษณ์
 * -> เสนอจ้าง -> แปลงเป็นพนักงาน (ต่อเข้า onboarding)
 * ==========================================================
 */

enum JobPostingStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum EmploymentTypeTag {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

/// ขั้นตอนของผู้สมัครใน pipeline เรียงตามลำดับจริง
enum JobApplicationStage {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

enum JobOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// ประกาศรับสมัครงาน
model JobPosting {
  id String @id @default(cuid())

  companyId    String
  branchId     String?
  departmentId String?
  positionId   String?

  code  String
  title String

  employmentType EmploymentTypeTag @default(FULL_TIME)

  /// จำนวนที่ต้องการรับ ใช้เทียบกับจำนวนที่จ้างได้จริง
  openings Int @default(1)

  description  String?
  requirement  String?
  salaryMin    Decimal? @db.Decimal(14, 2)
  salaryMax    Decimal? @db.Decimal(14, 2)
  workLocation String?

  status JobPostingStatus @default(DRAFT)

  openedAt    DateTime?
  closedAt    DateTime?
  /// วันปิดรับสมัครที่ตั้งไว้
  closingDate DateTime?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("JobPostingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  applications JobApplication[]

  @@unique([companyId, code])
  @@index([status])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("job_postings")
}

/// ใบสมัครของผู้สมัคร 1 คนต่อ 1 ประกาศ
model JobApplication {
  id String @id @default(cuid())

  companyId String
  postingId String

  /// ข้อมูลผู้สมัคร เก็บในใบสมัครโดยตรง ยังไม่เป็นพนักงาน
  firstName  String
  lastName   String
  email      String?
  phone      String?
  /// ข้อมูลส่วนตัวเพิ่มเติม — เก็บไว้ตั้งแต่ตอนสมัคร จะได้ไม่ต้องถามซ้ำตอนจ้าง
  nationalId String?
  birthDate  DateTime?
  address    String?

  /// ประวัติการทำงานปัจจุบัน
  currentPosition   String?
  currentCompany    String?
  currentSalary     Decimal? @db.Decimal(14, 2)
  yearsOfExperience Int?

  /// วุฒิการศึกษา
  educationLevel     String?
  educationInstitute String?
  educationMajor     String?

  /// ลิงก์เรซูเม่หรือแฟ้มผลงาน
  resumeUrl String?

  expectedSalary Decimal?  @db.Decimal(14, 2)
  availableFrom  DateTime?
  source         String?
  note           String?

  stage        JobApplicationStage @default(NEW)
  rejectReason String?

  /// คะแนนคัดกรองเบื้องต้น 0-10
  screeningScore Int?

  appliedAt DateTime @default(now())
  stagedAt  DateTime @default(now())

  /// พนักงานที่เกิดจากการจ้างผู้สมัครคนนี้
  hiredEmployeeId String? @unique

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  posting JobPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  hiredEmployee Employee? @relation("JobApplicationHiredEmployee", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  createdBy     User?     @relation("JobApplicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  attachments JobApplicationAttachment[]
  interviews  JobInterview[]
  offers      JobOffer[]

  @@index([companyId])
  @@index([postingId])
  @@index([stage])
  @@index([email])
  @@index([deletedAt])
  @@map("job_applications")
}

/// เรซูเม่และเอกสารแนบของผู้สมัคร
model JobApplicationAttachment {
  id            String @id @default(cuid())
  applicationId String

  fileName String
  fileSize Int?
  mimeType String?

  storageProvider String  @default("LOCAL")
  storageBucket   String?
  storageKey      String

  uploadedById String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User?          @relation("JobApplicationAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([deletedAt])
  @@map("job_application_attachments")
}

/// นัดสัมภาษณ์และผลสัมภาษณ์
model JobInterview {
  id            String @id @default(cuid())
  applicationId String

  /// รอบที่เท่าไหร่ เช่น 1 = HR, 2 = ผู้จัดการ
  round           Int      @default(1)
  scheduledAt     DateTime
  location        String?
  interviewerId   String?
  interviewerName String?

  result   InterviewResult @default(PENDING)
  /// คะแนนรวม 0-10
  score    Int?
  strength String?
  weakness String?
  note     String?

  completedAt DateTime?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User?          @relation("JobInterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("JobInterviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([result])
  @@index([deletedAt])
  @@map("job_interviews")
}

/// จดหมายเสนอจ้าง
model JobOffer {
  id            String @id @default(cuid())
  applicationId String

  offeredSalary Decimal   @db.Decimal(14, 2)
  startDate     DateTime
  /// จำนวนวันทดลองงานที่เสนอ ใช้ต่อยอดเป็น ProbationRecord ตอนแปลงเป็นพนักงาน
  probationDays Int       @default(119)
  /// วันหมดอายุของข้อเสนอ
  expiresAt     DateTime?

  benefitNote String?
  note        String?

  status JobOfferStatus @default(DRAFT)

  sentAt        DateTime?
  respondedAt   DateTime?
  /// ผู้ใช้ที่ "บันทึก" คำตอบของผู้สมัคร — ผู้สมัครไม่ได้เข้าระบบเอง HR เป็นคนคีย์แทน
  /// ต้องรู้ว่าใครคีย์ เผื่อมีข้อโต้แย้งภายหลังว่า "ไม่เคยตอบรับ"
  respondedById String?

  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("JobOfferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  respondedBy User?          @relation("JobOfferRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([status])
  @@index([deletedAt])
  @@map("job_offers")
}

/**
 * =========================
 * MOBILE (ADDITIVE — ดูรายละเอียดใน docs/mobile/API_MAPPING_MATRIX.md)
 * =========================
 * ตารางในกลุ่มนี้เก็บเฉพาะข้อมูลที่ "เป็นของ Mobile จริง ๆ" ตาม ADR-001 ข้อ 10
 * คือ Device/Push Token กับ Idempotency เท่านั้น
 * ห้ามสร้าง MobileEmployee / MobileAttendance / MobileLeave / MobilePayroll ซ้ำกับ core
 */

/// ทะเบียนเครื่องที่ติดตั้งแอปพนักงาน (BE-MOB-004)
/// หนึ่ง user มีได้หลายเครื่อง แต่หนึ่ง installationId ผูกกับ user เดียว
model MobileDevice {
  id String @id @default(cuid())

  userId         String
  installationId String  @unique
  platform       String
  deviceName     String?
  deviceModel    String?
  osVersion      String?
  appVersion     String?
  appBuild       Int?

  expoPushToken          String?
  /// UNKNOWN | GRANTED | DENIED | INVALID
  pushStatus             String  @default("UNKNOWN")
  notificationPermission String  @default("UNKNOWN")

  locale     String?
  timezone   String?
  lastSeenAt DateTime?

  lastIpAddress String?
  lastUserAgent String?
  revokedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expoPushToken])
  @@index([revokedAt])
  @@map("mobile_devices")
}

/// ซองกัน mutation ซ้ำสำหรับ Mobile (BE-MOB-005)
/// key เดิม + request hash เดิม = คืนผลเดิม, key เดิม + hash ต่าง = 409 IDEMPOTENCY_CONFLICT
model MobileIdempotencyRecord {
  id String @id @default(cuid())

  userId String
  /// ขอบเขตของ key เช่น "attendance:punch" เพื่อไม่ให้ key ชนกันข้ามฟีเจอร์
  scope  String
  key    String

  requestHash String

  responseStatus Int?
  responseBody   Json?
  completedAt    DateTime?

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("mobile_idempotency_records")
}

// =========================================================
// WITHHOLDING TAX — การจ่ายเงินให้ผู้รับที่ไม่ใช่ลูกจ้าง (ภ.ง.ด.3 / ภ.ง.ด.53)
// =========================================================

/// ผู้รับเงินที่ไม่ใช่ลูกจ้าง — ฟรีแลนซ์ ผู้ให้เช่า ผู้รับจ้างทำของ ฯลฯ
///
/// แยกจาก Employee เพราะคนกลุ่มนี้ไม่มีสัญญาจ้าง ไม่มีรอบเงินเดือน และคิดภาษี
/// คนละมาตรา — ลูกจ้างใช้ 40(1) หักตามขั้นบันได ส่วนกลุ่มนี้ใช้ 40(5)-(8)
/// หักอัตราคงที่ตามประเภทเงินได้
model WithholdingPayee {
  id        String @id @default(cuid())
  companyId String

  type WithholdingPayeeType @default(INDIVIDUAL)

  /// เลขประจำตัวผู้เสียภาษี 13 หลัก — บุคคลธรรมดาใช้เลขบัตรประชาชน
  taxId String

  /// สาขาที่ของผู้รับเงิน 5 หลัก สำนักงานใหญ่ = 00000 (ใช้เฉพาะนิติบุคคล)
  branchNo String @default("00000")

  /// บุคคลธรรมดาแยกคำนำหน้า/ชื่อ/สกุล ส่วนนิติบุคคลเก็บชื่อเต็มไว้ที่ name
  title     String?
  firstName String?
  lastName  String?
  /// ชื่อที่ใช้แสดงและพิมพ์ลงแบบฟอร์ม เติมให้อัตโนมัติจากสามช่องข้างบนถ้าเป็นบุคคล
  name      String

  address String?
  phone   String?
  note    String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payments WithholdingPayment[]

  /// เลขผู้เสียภาษีซ้ำในบริษัทเดียวกันไม่ได้ กันสร้างผู้รับเงินคนเดิมซ้ำ
  @@unique([companyId, taxId, branchNo])
  @@index([companyId, status, deletedAt])
  @@index([name])
  @@map("withholding_payees")
}

/// รายการจ่ายเงินหนึ่งครั้งให้ผู้รับเงินหนึ่งราย = หนึ่งบรรทัดบนใบแนบ ภ.ง.ด.3
model WithholdingPayment {
  id        String @id @default(cuid())
  companyId String
  payeeId   String

  /// วันที่จ่ายจริง ใช้จัดกลุ่มว่าอยู่แบบยื่นของเดือนไหน
  paidOn DateTime @db.Date

  /// รหัสประเภทเงินได้จากรายการมาตรฐาน (ดู withholding-income-type.constant.ts)
  incomeTypeCode  String
  /// ข้อความที่พิมพ์ลงช่อง "ประเภทเงินได้" แก้เองได้ถ้าต้องระบุให้ชัดกว่ารายการมาตรฐาน
  incomeTypeLabel String

  /// อัตราภาษีร้อยละ เก็บแยกจากรายการมาตรฐานเพราะอัตราเปลี่ยนได้ตามเวลา
  taxRatePercent Decimal @db.Decimal(6, 3)

  /// จำนวนเงินที่จ่าย และภาษีที่หักไว้จริง
  amount    Decimal @db.Decimal(14, 2)
  taxAmount Decimal @db.Decimal(14, 2)

  condition WithholdingCondition @default(WITHHELD)

  /// เลขที่เอกสารอ้างอิงฝั่งบัญชี เช่น เลขที่ใบสำคัญจ่าย
  reference String?
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payee   WithholdingPayee @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([companyId, paidOn, deletedAt])
  @@index([payeeId])
  @@map("withholding_payments")
}

/// ผู้รับเงินเป็นบุคคลธรรมดาหรือนิติบุคคล — ตัวนี้ตัดสินว่ายื่นแบบไหน
/// บุคคลธรรมดา = ภ.ง.ด.3 · นิติบุคคล = ภ.ง.ด.53
enum WithholdingPayeeType {
  INDIVIDUAL
  JURISTIC
}

/// เงื่อนไขการหักภาษี ตามหมายเหตุท้ายใบแนบ (กรอก 1 / 2 / 3)
enum WithholdingCondition {
  /// 1 = หัก ณ ที่จ่าย
  WITHHELD
  /// 2 = ผู้จ่ายออกภาษีให้ตลอดไป
  PAID_ALWAYS
  /// 3 = ผู้จ่ายออกภาษีให้ครั้งเดียว
  PAID_ONCE
}
