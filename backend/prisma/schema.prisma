model AttendanceImport {
  id String @id @default(cuid())

  fileName String
  fileSize Int?
  mimeType String?

  storageProvider String  @default("LOCAL")
  storageKey      String?
  bucketName      String?

  status AttendanceImportStatus @default(PENDING)

  totalRows    Int @default(0)
  importedRows Int @default(0)
  errorRows    Int @default(0)

  errorMessage String?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("AttendanceImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("attendance_imports")
