model AttendanceDailySummary {
  id String @id @default(cuid())

  employeeId String
  workDate   DateTime @db.Date

  morningInAt   DateTime?
  afternoonInAt DateTime?
  checkOutAt    DateTime?

  morningLateMinutes   Int @default(0)
  afternoonLateMinutes Int @default(0)
  totalLateMinutes     Int @default(0)

  isMorningMissing   Boolean @default(false)
  isAfternoonMissing Boolean @default(false)
  isCheckoutMissing  Boolean @default(false)
  hasMissingLog      Boolean @default(false)

  isAbsent   Boolean @default(false)
  absentDays Decimal @default(0) @db.Decimal(8, 2)

  earlyCheckoutMinutes Int @default(0)
  lateCheckoutMinutes  Int @default(0)
  extraPresenceMinutes Int @default(0)

  latePenaltyAmount             Decimal @default(0) @db.Decimal(14, 2)
  missingLogPenaltyAmount       Decimal @default(0) @db.Decimal(14, 2)
  missingMorningPenaltyAmount   Decimal @default(0) @db.Decimal(14, 2)
  missingAfternoonPenaltyAmount Decimal @default(0) @db.Decimal(14, 2)
  missingCheckoutPenaltyAmount  Decimal @default(0) @db.Decimal(14, 2)
  earlyCheckoutPenaltyAmount    Decimal @default(0) @db.Decimal(14, 2)
  absentDeductionAmount         Decimal @default(0) @db.Decimal(14, 2)
  unpaidLeaveDeductionAmount    Decimal @default(0) @db.Decimal(14, 2)
  totalDeductionAmount          Decimal @default(0) @db.Decimal(14, 2)

  paidLeaveMinutes   Int @default(0)
  unpaidLeaveMinutes Int @default(0)
  offsiteMinutes     Int @default(0)
  approvedOtMinutes  Int @default(0)
  payableOtMinutes   Int @default(0)

  offsiteStatus String?
  reviewStatus  AttendanceReviewStatus @default(CALCULATED)

  leaveRequestId    String?
  leaveTypeId       String?
  leaveIsPaid       Boolean?
  leaveDayType      LeaveDayType?
  leaveDurationDays Decimal       @default(0) @db.Decimal(8, 2)

  policyId          String?
  policySnapshot    Json?
  calculationStatus String   @default("CALCULATED")
  calculationNote   String?
  calculatedAt      DateTime @default(now())
  calculatedById    String?

  reviewedAt          DateTime?
  reviewedById        String?

  /// HR ยกเว้นค่าปรับลืมสแกนของวันนี้ — ตัดสินใจรายวัน ไม่ใช่รายคนทั้งเดือน
  /// ต้องรอดจากการคำนวณใหม่ ตัวคำนวณจึงอ่านค่าเดิมกลับมาใส่ทุกครั้ง
  missingLogPenaltyWaived Boolean   @default(false)
  penaltyWaivedReason     String?
  penaltyWaivedAt         DateTime?
  penaltyWaivedById       String?
  /// ยอดที่ถูกยกเว้นไว้ กดกลับมาหักแล้วคืนยอดเดิมได้โดยไม่ต้องคำนวณใหม่
  penaltyWaivedAmount     Decimal   @default(0) @db.Decimal(14, 2)

  /// ยกเว้นค่าปรับ "ช่วงบ่าย" ของวันนี้ — ทั้งมาสายบ่ายและลืมสแกนเข้าบ่าย
  ///
  /// แยกจาก missingLogPenaltyWaived เพราะเป็นคนละการตัดสินใจ ตัวนั้นคือ
  /// "วันนี้ลืมสแกนแต่ไม่หัก" ส่วนตัวนี้คือ "ช่วงบ่ายของวันนี้ไม่คิดค่าปรับเลย"
  /// ใช้ตอนคนออกไปทำงานนอกบริษัทช่วงบ่ายจนกลับมาสแกนไม่ทัน
  ///
  /// ยังนับนาทีสายและสถานะขาดสแกนตามจริงทุกอย่าง ตัดแค่ยอดเงิน
  /// เพื่อให้รายงานยังบอกได้ว่าวันนั้นเกิดอะไรขึ้น
  afternoonPenaltyWaived       Boolean @default(false)
  afternoonPenaltyWaivedReason String?
  /// ยอดค่าปรับช่วงบ่ายที่ถูกยกเว้นไป (ก่อนเพดานรายวัน) เก็บไว้ให้ตรวจสอบย้อนหลัง
  afternoonPenaltyWaivedAmount Decimal @default(0) @db.Decimal(14, 2)

  readyForPayrollAt   DateTime?
  readyForPayrollById String?
  lockedAt            DateTime?
  lockedById          String?

  payrollPeriodId   String?
  payrollRunId      String?
  sentToPayrollAt   DateTime?
  sentToPayrollById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  leaveType    LeaveType?    @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  calculatedBy User?         @relation("AttendanceDailySummaryCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, workDate])
  @@index([leaveRequestId])
  @@index([leaveTypeId])
  @@index([policyId])
  @@index([calculationStatus])
  @@index([reviewStatus])
  @@index([workDate, employeeId], map: "idx_hr_review_ads_workdate_employee")
  @@index([employeeId, workDate, reviewStatus], map: "idx_hr_review_ads_employee_date_status")
  @@index([workDate, reviewStatus], map: "idx_hr_review_ads_workdate_status")
  @@index([offsiteStatus])
  @@index([calculatedById])
  @@index([reviewedById])
  // ไม่ประกาศ @@index([missingLogPenaltyWaived]) ตรงนี้โดยตั้งใจ
  // migration 20260904030000 สร้างไว้เป็น partial index (WHERE = true) ซึ่งเขียนใน
  // schema ของ Prisma ไม่ได้ ถ้าเติมบรรทัด @@index กลับมา schema จะเพี้ยนจากสาย
  // migration ทันที และ prisma migrate diff จะสั่งสร้าง index ซ้ำอีกตัว
  @@index([readyForPayrollById])
  @@index([lockedById])
  @@index([payrollPeriodId])
  @@index([payrollRunId])
  @@index([lockedAt])
  @@map("attendance_daily_summaries")
}

