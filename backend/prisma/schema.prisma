  createdBy    User? @relation("ExportFileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  downloadedBy User? @relation("ExportFileDownloadedBy", fields: [downloadedById], references: [id], onDelete: SetNull)

