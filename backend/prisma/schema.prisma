  @@index([companyId])
  @@index([reportJobId])
  @@index([reportCode])
  @@index([format])
  @@index([createdById])
  @@index([downloadedById])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("export_files")
}

model ReportLog {
