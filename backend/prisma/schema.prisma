/// ประเภทของรายการหักแบบผ่อนงวด
enum EmployeeDeductionPlanType {
  /// กยศ. / กรอ. — นายจ้างมีหน้าที่หักและนำส่งตามกฎหมาย
  STUDENT_LOAN
  /// เงินกู้สวัสดิการพนักงาน
  EMPLOYEE_LOAN
  /// หุ้น/เงินกู้สหกรณ์
  COOPERATIVE
  /// รายการผ่อนอื่น ๆ เช่น ค่าเครื่องแบบ ค่าอุปกรณ์
  OTHER
  /// เงินประกันการทำงาน — ม.10 เรียกได้เฉพาะงานที่รับผิดชอบเงินหรือทรัพย์สิน
  /// และต้องคืนภายใน 7 วันนับแต่วันที่เลิกจ้างหรือลาออก
  WORK_GUARANTEE
  /// ชำระค่าเสียหาย — ม.76 ต้องมีหนังสือยินยอมจากลูกจ้าง
  /// และรวมรายการหักทั้งหมดแล้วต้องไม่เกิน 10% ของค่าจ้างงวดนั้น
  DAMAGE_PAYMENT
}

