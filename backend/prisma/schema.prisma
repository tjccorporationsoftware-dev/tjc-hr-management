/**
 * =========================
 * AUTH / USER / RBAC
 * =========================
 */

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  passwordHash       String
  displayName        String
  /// รหัสผ่านถูกตั้งให้โดยผู้ดูแล — ต้องเปลี่ยนเองก่อนใช้งานระบบ
  /// ถ้าไม่บังคับ ผู้ดูแลจะรู้รหัสผ่านของทุกคนตลอดไป
  mustChangePassword Boolean @default(false)
  phone              String?
  avatarUrl          String?

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  // --- Tenant scope ---
  scopeLevel      ScopeLevel @default(BRANCH)
  scopedCompanyId String?
  scopedBranchId  String?

  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?

  twoFactorEnabled        Boolean   @default(false)
  twoFactorCodeHash       String?
  twoFactorCodeExpiresAt  DateTime?
  twoFactorRequestedAt    DateTime?
  twoFactorLastVerifiedAt DateTime?
  twoFactorFailedAttempts Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  scopedCompany Company? @relation("UserScopedCompany", fields: [scopedCompanyId], references: [id], onDelete: Restrict)
  scopedBranch  Branch?  @relation("UserScopedBranch", fields: [scopedBranchId], references: [id], onDelete: Restrict)

  roles                 UserRole[]
  sessions              UserSession[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  mobilePushPreferences MobilePushPreference[]

  employee Employee?

  uploadedEmployeeDocuments    EmployeeDocument[]
  createdEmployeeWorkHistories EmployeeWorkHistory[]

  createdEmployeeTransfers   EmployeeTransfer[] @relation("EmployeeTransferCreatedBy")
  cancelledEmployeeTransfers EmployeeTransfer[] @relation("EmployeeTransferCancelledBy")

  submittedEmployeeResignations EmployeeResignation[] @relation("EmployeeResignationSubmittedBy")
  approvedEmployeeResignations  EmployeeResignation[] @relation("EmployeeResignationApprovedBy")
  rejectedEmployeeResignations  EmployeeResignation[] @relation("EmployeeResignationRejectedBy")
  cancelledEmployeeResignations EmployeeResignation[] @relation("EmployeeResignationCancelledBy")

  createdAttendanceLogs    AttendanceLog[]     @relation("AttendanceLogCreatedBy")
  editedAttendanceLogs     AttendanceEditLog[] @relation("AttendanceEditLogEditedBy")
  createdAttendanceImports AttendanceImport[]  @relation("AttendanceImportCreatedBy")
  createdDataImports       DataImport[]        @relation("DataImportCreatedBy")
  submittedLeaveRequests   LeaveRequest[]      @relation("LeaveRequestSubmittedBy")
  cancelledLeaveRequests   LeaveRequest[]      @relation("LeaveRequestCancelledBy")
  leaveApprovalLogs        LeaveApprovalLog[]  @relation("LeaveApprovalLogApprovedBy")
  leaveApprovalSteps       LeaveApprovalStep[] @relation("LeaveApprovalStepExpectedApprover")
  actedLeaveApprovalSteps  LeaveApprovalStep[] @relation("LeaveApprovalStepActedBy")
  uploadedLeaveAttachments LeaveAttachment[]   @relation("LeaveAttachmentUploadedBy")

  submittedOvertimeRequests   OvertimeRequest[]      @relation("OvertimeRequestSubmittedBy")
  cancelledOvertimeRequests   OvertimeRequest[]      @relation("OvertimeRequestCancelledBy")
  overtimeApprovalLogs        OvertimeApprovalLog[]  @relation("OvertimeApprovalLogApprovedBy")
  overtimeApprovalSteps       OvertimeApprovalStep[] @relation("OvertimeApprovalStepExpectedApprover")
  actedOvertimeApprovalSteps  OvertimeApprovalStep[] @relation("OvertimeApprovalStepActedBy")
  uploadedOvertimeAttachments OvertimeAttachment[]   @relation("OvertimeAttachmentUploadedBy")

  submittedTimeAdjustRequests   TimeAdjustRequest[]      @relation("TimeAdjustRequestSubmittedBy")
  approvedTimeAdjustRequests    TimeAdjustRequest[]      @relation("TimeAdjustRequestApprovedBy")
  rejectedTimeAdjustRequests    TimeAdjustRequest[]      @relation("TimeAdjustRequestRejectedBy")
  cancelledTimeAdjustRequests   TimeAdjustRequest[]      @relation("TimeAdjustRequestCancelledBy")
  timeAdjustLogs                TimeAdjustLog[]          @relation("TimeAdjustLogActedBy")
  timeAdjustApprovalSteps       TimeAdjustApprovalStep[] @relation("TimeAdjustApprovalStepExpectedApprover")
  actedTimeAdjustApprovalSteps  TimeAdjustApprovalStep[] @relation("TimeAdjustApprovalStepActedBy")
  uploadedTimeAdjustAttachments TimeAdjustAttachment[]   @relation("TimeAdjustAttachmentUploadedBy")

  submittedDocumentRequests DocumentRequest[]  @relation("DocumentRequestSubmittedBy")
  approvedDocumentRequests  DocumentRequest[]  @relation("DocumentRequestApprovedBy")
  rejectedDocumentRequests  DocumentRequest[]  @relation("DocumentRequestRejectedBy")
  cancelledDocumentRequests DocumentRequest[]  @relation("DocumentRequestCancelledBy")
  documentApprovalLogs      DocumentApproval[] @relation("DocumentApprovalActedBy")
  uploadedDocumentFiles     DocumentFile[]     @relation("DocumentFileUploadedBy")
  createdDocumentTemplates  DocumentTemplate[] @relation("DocumentTemplateCreatedBy")

  /// การมอบอำนาจอนุมัติแทน — ทั้งฝั่งที่มอบและฝั่งที่รับมอบ
  delegatedApprovalsGiven    ApprovalDelegation[] @relation("ApprovalDelegationDelegator")
  delegatedApprovalsReceived ApprovalDelegation[] @relation("ApprovalDelegationDelegate")
  createdApprovalDelegations ApprovalDelegation[] @relation("ApprovalDelegationCreatedBy")
  revokedApprovalDelegations ApprovalDelegation[] @relation("ApprovalDelegationRevokedBy")

  submittedComplaints Complaint[] @relation("ComplaintSubmittedBy")
  handledComplaints   Complaint[] @relation("ComplaintHandledBy")

  createdEvaluationForms EvaluationForm[] @relation("EvaluationFormCreatedBy")

  createdEvaluationResults   EvaluationResult[] @relation("EvaluationResultCreatedBy")
  submittedEvaluationResults EvaluationResult[] @relation("EvaluationResultSubmittedBy")
  finalizedEvaluationResults EvaluationResult[] @relation("EvaluationResultFinalizedBy")

  evaluatorUserAssignments Evaluator[] @relation("EvaluatorUser")
  createdEvaluators        Evaluator[] @relation("EvaluatorCreatedBy")

  uploadedEvaluationAttachments EvaluationAttachment[] @relation("EvaluationAttachmentUploadedBy")

  createdWarningLetters      WarningLetter[] @relation("WarningLetterCreatedBy")
  issuedWarningLetters       WarningLetter[] @relation("WarningLetterIssuedBy")
  acknowledgedWarningLetters WarningLetter[] @relation("WarningLetterAcknowledgedBy")
  cancelledWarningLetters    WarningLetter[] @relation("WarningLetterCancelledBy")

  createdDisciplinaryHistories DisciplinaryHistory[] @relation("DisciplinaryHistoryCreatedBy")

  createdOnboardingChecklists OnboardingChecklist[] @relation("OnboardingChecklistCreatedBy")
  createdOnboardingTasks      OnboardingTask[]      @relation("OnboardingTaskCreatedBy")
  completedOnboardingTasks    OnboardingTask[]      @relation("OnboardingTaskCompletedBy")
  cancelledOnboardingTasks    OnboardingTask[]      @relation("OnboardingTaskCancelledBy")

  createdOnboardingDocuments   OnboardingDocument[] @relation("OnboardingDocumentCreatedBy")
  submittedOnboardingDocuments OnboardingDocument[] @relation("OnboardingDocumentSubmittedBy")
  verifiedOnboardingDocuments  OnboardingDocument[] @relation("OnboardingDocumentVerifiedBy")
  rejectedOnboardingDocuments  OnboardingDocument[] @relation("OnboardingDocumentRejectedBy")

  createdProbationRecords  ProbationRecord[] @relation("ProbationRecordCreatedBy")
  reviewedProbationRecords ProbationRecord[] @relation("ProbationRecordReviewedBy")

  createdJobPostings     JobPosting[]               @relation("JobPostingCreatedBy")
  createdJobApplications JobApplication[]           @relation("JobApplicationCreatedBy")
  uploadedJobAttachments JobApplicationAttachment[] @relation("JobApplicationAttachmentUploadedBy")
  conductedJobInterviews JobInterview[]             @relation("JobInterviewInterviewer")
  createdJobInterviews   JobInterview[]             @relation("JobInterviewCreatedBy")
  respondedJobOffers     JobOffer[]                 @relation("JobOfferRespondedBy")
  createdJobOffers       JobOffer[]                 @relation("JobOfferCreatedBy")

  createdOffboardingChecklists OffboardingChecklist[] @relation("OffboardingChecklistCreatedBy")
  createdOffboardingCases      OffboardingCase[]      @relation("OffboardingCaseCreatedBy")
  completedOffboardingCases    OffboardingCase[]      @relation("OffboardingCaseCompletedBy")
  completedOffboardingTasks    OffboardingTask[]      @relation("OffboardingTaskCompletedBy")
  conductedExitInterviews      ExitInterview[]        @relation("ExitInterviewInterviewer")

  createdReportJobs   ReportJob[] @relation("ReportJobCreatedBy")
  cancelledReportJobs ReportJob[] @relation("ReportJobCancelledBy")

  createdExportFiles    ExportFile[] @relation("ExportFileCreatedBy")
  downloadedExportFiles ExportFile[] @relation("ExportFileDownloadedBy")

  createdReportLogs ReportLog[] @relation("ReportLogCreatedBy")

  mobileDevices            MobileDevice[]
  mobileIdempotencyRecords MobileIdempotencyRecord[]

  createdPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodCreatedBy")

  createdPayrollRuns                 PayrollRun[]             @relation("PayrollRunCreatedBy")
  calculatedPayrollRuns              PayrollRun[]             @relation("PayrollRunCalculatedBy")
  reviewedPayrollRuns                PayrollRun[]             @relation("PayrollRunReviewedBy")
  approvedPayrollRuns                PayrollRun[]             @relation("PayrollRunApprovedBy")
  paidPayrollRuns                    PayrollRun[]             @relation("PayrollRunPaidBy")
  cancelledPayrollRuns               PayrollRun[]             @relation("PayrollRunCancelledBy")
  attendanceDailySummariesCalculated AttendanceDailySummary[] @relation("AttendanceDailySummaryCalculatedBy")

  @@index([email])
  @@index([scopedCompanyId])
  @@index([scopedBranchId])
  @@index([status])
  @@index([deletedAt])
  @@index([lockedUntil])
}

model Role {
  id          String  @id @default(cuid())
  // null = โรลระบบ (template กลาง ใช้ร่วมทุกบริษัท) · มีค่า = custom role ของบริษัทนั้น
  companyId   String?
  code        String
  name        String
  description String?

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([code])
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  group       String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([code])
  @@index([group])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id               String @id @default(cuid())
  userId           String
  refreshTokenHash String

  ipAddress  String?
  userAgent  String?
  deviceName String?

  /// ---- Mobile session metadata (additive; เว็บยังคงเป็น sessionType = WEB) ----
  /// ผูก session กับเครื่องที่ติดตั้งแอป เพื่อกัน refresh token ถูกใช้ข้ามเครื่อง
  installationId String?
  platform       String?
  appVersion     String?
  appBuild       Int?
  /// WEB | MOBILE — ใช้แยกนโยบาย/รายงาน ไม่กระทบ session เดิมที่ default เป็น WEB
  sessionType    String    @default("WEB")
  lastSeenAt     DateTime?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([installationId])
}

/**
 * =========================
 * ORGANIZATION / MASTER DATA
 * =========================
 */

model Company {
  id      String  @id @default(cuid())
  code    String  @unique
  nameTh  String
  nameEn  String?
  taxId   String?
  address String?
  phone   String?
  email   String?
  logoUrl String?

  /// เลขที่บัญชีนายจ้าง (10 หลัก) ใช้ในหัวแบบ สปส.1-10
  socialSecurityAccountNo String?
  /// ลำดับที่สาขาของนายจ้าง ปกติ "000" ถ้าไม่ได้แยกสาขา
  socialSecurityBranchNo  String?
  /// รหัสกิจการของกองทุนเงินทดแทน ใช้ในแบบ กท.20 / กท.20ก
  workmenCompensationCode String?
  /// อัตราเงินสมทบกองทุนเงินทดแทน (ร้อยละ) เช่น 0.04 — ขึ้นกับความเสี่ยงของประเภทกิจการ
  workmenCompensationRate Decimal? @db.Decimal(6, 4)

  /// รหัสบริษัทที่ธนาคารออกให้ ใช้ในไฟล์นำเข้าระบบจ่ายเงินเดือน
  bankCompanyCode    String?
  /// เลขที่บัญชีบริษัทที่ใช้ตัดจ่ายเงินเดือน
  bankDebitAccountNo String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches                 Branch[]
  departments              Department[]
  positions                Position[]
  employeeTypes            EmployeeType[]
  paymentAccounts          PaymentAccount[]
  withholdingPayees        WithholdingPayee[]
  withholdingPayments      WithholdingPayment[]
  taxMethods               TaxMethod[]
  socialInsuranceMethods   SocialInsuranceMethod[]
  holidayCalendars         HolidayCalendar[]
  holidaySwaps             HolidaySwap[]
  holidayWorkAssignments   HolidayWorkAssignment[]
  substituteHolidayCredits SubstituteHolidayCredit[]
  roles                    Role[]

  employees   Employee[]
  scopedUsers User[]     @relation("UserScopedCompany")

  attendanceLocations AttendanceLocation[]
  leaveTypes          LeaveType[]
  leavePolicies       LeavePolicy[]
  overtimePolicies    OvertimePolicy[]
  documentTypes       DocumentType[]
  documentRequests    DocumentRequest[]
  documentTemplates   DocumentTemplate[]
  complaints          Complaint[]

  evaluationForms   EvaluationForm[]
  evaluationResults EvaluationResult[]

  warningLetters        WarningLetter[]
  disciplinaryHistories DisciplinaryHistory[]

  onboardingChecklists OnboardingChecklist[]
  onboardingTasks      OnboardingTask[]
  onboardingDocuments  OnboardingDocument[]
  probationRecords     ProbationRecord[]

  offboardingChecklists OffboardingChecklist[]
  offboardingCases      OffboardingCase[]
  offboardingTasks      OffboardingTask[]

  jobPostings     JobPosting[]
  jobApplications JobApplication[]

  reportJobs  ReportJob[]
  exportFiles ExportFile[]
  reportLogs  ReportLog[]

  payrollComponents      PayrollComponent[]
  employeeCompensations  EmployeeCompensation[]
  employeeDeductionPlans EmployeeDeductionPlan[]
  payrollPeriods         PayrollPeriod[]
  payrollRuns            PayrollRun[]
  payrollSetting         CompanyPayrollSetting?

  payrollTaxYears          PayrollTaxYear[]
  employeeTaxProfiles      EmployeeTaxProfile[]
  employeeTaxYearSummaries EmployeeTaxYearSummary[]
  payrollTaxCalculations   PayrollTaxCalculation[]

  approvalMatrices    ApprovalMatrix[]
  approvalDelegations ApprovalDelegation[]
  employeeProfiles    EmployeeProfile[]
  employeeFamily      EmployeeFamilyMember[]
  employeeEducations  EmployeeEducation[]
  auditLogs           AuditLog[]

  oldEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryOldCompany")
  newEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryNewCompany")

  dataImports       DataImport[]
  employeeTransfers EmployeeTransfer[]

  @@index([code])
  @@index([status])
  @@index([deletedAt])
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  code      String
  nameTh    String
  nameEn    String?
  address   String?
  phone     String?
  email     String?

  /// โลโก้ประจำสาขา (ไฟล์อยู่ใต้ /uploads/branch-logos)
  /// สาขาที่จดทะเบียนเป็นนิติบุคคล/แบรนด์คนละตัวกับสำนักงานใหญ่ ใช้หัวเอกสารของตัวเองได้
  logoUrl String?

  /// เปิดใช้ข้อมูลชุดนี้เป็นหัวสลิปเงินเดือนแทนของบริษัท
  /// ช่องไหนในสาขาเว้นว่าง สลิปจะถอยไปใช้ค่าของบริษัทให้เองทีละช่อง
  usePayslipHeader Boolean @default(false)

  /// เลขประจำตัวผู้เสียภาษีที่พิมพ์บนเอกสารของสาขา (ปกติเลขเดียวกับบริษัท)
  taxId String?
  /// เลขที่สาขาในระบบภาษี 5 หลัก (00000 = สำนักงานใหญ่)
  taxBranchNo String?
  /// ลำดับที่สาขาของนายจ้างในระบบประกันสังคม เช่น 001
  socialSecurityBranchNo String?
  /// ข้อความท้ายสลิปเฉพาะสาขา เช่น ช่องทางติดต่อฝ่ายบุคคลประจำสาขา
  payslipNote String?

  /// ลำดับที่อยากให้สาขานี้ปรากฏในทุกรายการ (น้อย = ขึ้นก่อน)
  ///
  /// เดิมเรียงตามชื่อไทย ซึ่งเอาสำนักงานใหญ่ไปกองรวมกับสาขาอื่นตามตัวอักษร
  /// (ตั้งใจ มาก่อน ทีเจซี) ทั้งที่คนอ่านทะเบียนพนักงานมองหาสำนักงานใหญ่ก่อนเสมอ
  /// ค่าเท่ากันจะถอยไปเรียงตามชื่อเหมือนเดิม
  sortOrder Int @default(100)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments      Department[]
  jobPostings      JobPosting[]
  approvalMatrices ApprovalMatrix[]

  approvalMatrixBranches ApprovalMatrixBranch[]

  employees   Employee[]
  scopedUsers User[]     @relation("UserScopedBranch")

  attendanceLocations AttendanceLocation[]
  attendanceDevices   AttendanceDevice[]
  leavePolicies       LeavePolicy[]
  overtimePolicies    OvertimePolicy[]

  oldEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryOldBranch")
  newEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryNewBranch")

  transfersFrom EmployeeTransfer[] @relation("EmployeeTransferFromBranch")
  transfersTo   EmployeeTransfer[] @relation("EmployeeTransferToBranch")

  @@unique([companyId, code])
  @@index([status])
  @@index([deletedAt])
}

/// รายการแผนกมาตรฐานระดับระบบ
///
/// แหล่งความจริงคือ `constants/department-catalog.constant.ts` ในโค้ด
/// ตารางนี้เป็นสำเนาที่ต้องมี เพราะ `Department.catalogId` ของบริษัทชี้มาที่นี่
model DepartmentCatalog {
  id String @id @default(cuid())

  /// รหัสอ้างอิงตามลำดับในไฟล์ค่าคงที่ เช่น "D01".."D15"
  referenceCode String
  code          String
  nameTh        String
  nameEn        String?
  description   String?
  sortOrder     Int     @default(0)

  /// true = รายการมาตรฐานที่ระบบซิงก์มา ห้ามลบ
  isSystem Boolean @default(true)

  /// true = แผนกพื้นฐานที่บริษัทส่วนใหญ่ต้องมี ใช้ทำเครื่องหมาย "แนะนำ" ในหน้าเลือก
  isDefault Boolean @default(false)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments      Department[]
  divisionCatalogs DivisionCatalog[]

  @@unique([referenceCode])
  @@unique([code])
  @@index([sortOrder])
  @@index([status])
  @@index([deletedAt])
  @@map("department_catalog")
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  branchId  String?
  code      String
  nameTh    String
  nameEn    String?

  /// ผูกกับรายการมาตรฐานระดับระบบ (null = แผนกที่บริษัทสร้างเอง)
  catalogId     String?
  referenceCode String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  catalog   DepartmentCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  divisions Division[]

  employees   Employee[]
  jobPostings JobPosting[]

  approvalMatrices ApprovalMatrix[]

  oldEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryOldDepartment")
  newEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryNewDepartment")

  transfersFrom EmployeeTransfer[] @relation("EmployeeTransferFromDepartment")
  transfersTo   EmployeeTransfer[] @relation("EmployeeTransferToDepartment")

  @@unique([companyId, code])
  @@index([branchId])
  @@index([companyId, catalogId])
  @@index([catalogId])
  @@index([status])
  @@index([deletedAt])
}

/// รายการฝ่าย/กลุ่มงานมาตรฐานระดับระบบ
///
/// ต่างจาก catalog ตัวอื่นตรงที่ผูกกับแผนกมาตรฐานเสมอ (`departmentCatalogId`)
/// เพราะ `Division.departmentId` ในข้อมูลจริงเป็น required — ฝ่ายลอยเดี่ยวไม่ได้
/// ตอนบริษัทกดเปิดใช้ ระบบจึงต้องเปิดแผนกแม่ให้ก่อนถ้ายังไม่มี
model DivisionCatalog {
  id String @id @default(cuid())

  /// รหัสอ้างอิงตามลำดับในไฟล์ค่าคงที่ เช่น "V01".."V40"
  referenceCode       String
  departmentCatalogId String

  code        String
  nameTh      String
  nameEn      String?
  description String?
  sortOrder   Int     @default(0)

  isSystem Boolean @default(true)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departmentCatalog DepartmentCatalog @relation(fields: [departmentCatalogId], references: [id], onDelete: Cascade)
  divisions         Division[]

  @@unique([referenceCode])
  @@unique([code])
  @@index([departmentCatalogId])
  @@index([sortOrder])
  @@index([status])
  @@index([deletedAt])
  @@map("division_catalog")
}

model Division {
  id           String  @id @default(cuid())
  departmentId String
  code         String
  nameTh       String
  nameEn       String?

  /// ผูกกับรายการมาตรฐานระดับระบบ (null = ฝ่ายที่บริษัทสร้างเอง)
  catalogId     String?
  referenceCode String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  catalog    DivisionCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  department Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  employees Employee[]

  oldEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryOldDivision")
  newEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryNewDivision")

  transfersFrom EmployeeTransfer[] @relation("EmployeeTransferFromDivision")
  transfersTo   EmployeeTransfer[] @relation("EmployeeTransferToDivision")

  @@unique([departmentId, code])
  @@index([departmentId, catalogId])
  @@index([catalogId])
  @@index([status])
  @@index([deletedAt])
}

/// รายการประเภทพนักงานมาตรฐานระดับระบบ
///
/// แหล่งความจริงคือ `constants/employee-type-catalog.constant.ts` ในโค้ด
/// ตารางนี้เป็นสำเนาที่ต้องมี เพราะ `EmployeeType.catalogId` ของบริษัทชี้มาที่นี่
/// (แพตเทิร์นเดียวกับ LeaveTypeCatalog)
model EmployeeTypeCatalog {
  id String @id @default(cuid())

  /// รหัสอ้างอิงตามลำดับในไฟล์ค่าคงที่ เช่น "T01".."T09"
  referenceCode String
  code          String
  nameTh        String
  nameEn        String?
  description   String?
  sortOrder     Int     @default(0)

  /// true = รายการมาตรฐานที่ระบบซิงก์มา ห้ามลบ
  isSystem Boolean @default(true)

  /// true = ประเภทที่บริษัทเปิดใหม่ควรเปิดใช้ให้ตั้งแต่แรก (เช่น รายเดือน/รายวัน)
  isDefault Boolean @default(false)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employeeTypes EmployeeType[]

  @@unique([referenceCode])
  @@unique([code])
  @@index([sortOrder])
  @@index([status])
  @@index([deletedAt])
  @@map("employee_type_catalog")
}

model EmployeeType {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  nameTh      String
  nameEn      String?
  description String?

  /// ผูกกับรายการมาตรฐานระดับระบบ (null = ประเภทที่บริษัทสร้างเอง)
  catalogId     String?
  referenceCode String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  catalog          EmployeeTypeCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees        Employee[]
  leavePolicies    LeavePolicy[]
  overtimePolicies OvertimePolicy[]
  approvalMatrices ApprovalMatrix[]

  oldEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryOldEmployeeType")
  newEmployeeWorkHistories EmployeeWorkHistory[] @relation("EmployeeWorkHistoryNewEmployeeType")

  transfersFrom EmployeeTransfer[] @relation("EmployeeTransferFromEmployeeType")
  transfersTo   EmployeeTransfer[] @relation("EmployeeTransferToEmployeeType")

  @@unique([companyId, code])
  @@index([companyId, catalogId])
  @@index([catalogId])
  @@index([status])
  @@index([deletedAt])
}

/// รายการตำแหน่งมาตรฐานระดับระบบ
///
/// แหล่งความจริงคือ `constants/position-catalog.constant.ts` ในโค้ด
/// ตารางนี้เป็นสำเนาที่ต้องมี เพราะ `Position.catalogId` ของบริษัทชี้มาที่นี่
model PositionCatalog {
  id String @id @default(cuid())

  /// รหัสอ้างอิงตามลำดับในไฟล์ค่าคงที่ เช่น "P01".."P40"
  referenceCode String
  code          String
  nameTh        String
  nameEn        String?
  description   String?

  /// 1 = สูงสุด ไล่ลงถึง 9 (ตรงกับตัวเลือกระดับตำแหน่งในฟอร์ม)
  level     Int?
  sortOrder Int  @default(0)

  /// กลุ่มสายงานสำหรับจัดหมวดในหน้าเลือก เช่น GENERAL / HR / ACCOUNTING
  category String @default("GENERAL")

  /// true = รายการมาตรฐานที่ระบบซิงก์มา ห้ามลบ
  isSystem Boolean @default(true)

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  positions Position[]

  @@unique([referenceCode])
  @@unique([code])
  @@index([category])
  @@index([sortOrder])
  @@index([status])
  @@index([deletedAt])
  @@map("position_catalog")
}

model Position {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  nameTh      String
  nameEn      String?
  description String?
  level       Int?
  sortOrder   Int     @default(0)

  /// ผูกกับรายการมาตรฐานระดับระบบ (null = ตำแหน่งที่บริษัทสร้างเอง)
  catalogId     String?
  referenceCode String?

  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  catalog                 PositionCatalog?         @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees               Employee[]
  jobPostings             JobPosting[]
  approvalSteps           ApprovalMatrixStep[]     @relation("ApprovalStepPosition")
  approvalFallbackSteps   ApprovalMatrixStep[]     @relation("ApprovalStepFallbackPosition")
  leaveApprovalSteps      LeaveApprovalStep[]
  overtimeApprovalSteps   OvertimeApprovalStep[]
  timeAdjustApprovalSteps TimeAdjustApprovalStep[]

  transfersFrom EmployeeTransfer[] @relation("EmployeeTransferFromPosition")
  transfersTo   EmployeeTransfer[] @relation("EmployeeTransferToPosition")

  @@unique([companyId, code])
  @@index([companyId, catalogId])
  @@index([catalogId])
  @@index([status])
  @@index([deletedAt])
}

/// การมอบอำนาจอนุมัติแทน
///
/// เดิมระบบไม่มีทางออกเลยเมื่อผู้อนุมัติลาพักร้อนหรือลาป่วยยาว
/// ใบลา/OT ของทั้งทีมจะค้างจนกว่าเจ้าตัวจะกลับมา ทางเดียวคือให้ SYSTEM_ADMIN
/// กดข้ามให้ ซึ่งไม่มีร่องรอยว่ากดแทนใครและด้วยเหตุผลอะไร
model ApprovalDelegation {
  id        String @id @default(cuid())
  companyId String

  /// ผู้มอบอำนาจ — ผู้อนุมัติตัวจริงที่ไม่อยู่
  delegatorUserId String
  /// ผู้รับมอบอำนาจ — คนที่กดแทนได้ในช่วงเวลาที่กำหนด
  delegateUserId  String

  /// ช่วงที่มอบอำนาจ นับรวมวันเริ่มและวันสิ้นสุด
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// จำกัดเฉพาะบางประเภทรายการ — ว่าง = ทุกประเภทที่ระบบรองรับ
  targetTypes ApprovalMatrixTargetType[]

  reason String?

  status      MasterStatus @default(ACTIVE)
  revokedAt   DateTime?
  revokedById String?
  createdById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  delegator User    @relation("ApprovalDelegationDelegator", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegate  User    @relation("ApprovalDelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ApprovalDelegationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User?   @relation("ApprovalDelegationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([delegatorUserId])
  @@index([delegateUserId])
  @@index([startDate, endDate])
  @@index([status])
  @@index([deletedAt])
  @@map("approval_delegations")
}

model ApprovalMatrix {
  id             String                   @id @default(cuid())
  companyId      String
  code           String
  nameTh         String
  nameEn         String?
  description    String?
  targetType     ApprovalMatrixTargetType
  branchId       String?
  departmentId   String?
  employeeTypeId String?
  priority       Int                      @default(0)
  status         MasterStatus             @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company                 Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                  Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department              Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeType            EmployeeType?             @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  steps                   ApprovalMatrixStep[]
  requesters              ApprovalMatrixRequester[]
  /// สาขาเพิ่มเติมที่ใช้สายเดียวกัน (นอกเหนือจาก branchId ซึ่งเป็นสาขาแรก)
  extraBranches           ApprovalMatrixBranch[]
  leaveApprovalSteps      LeaveApprovalStep[]
  overtimeApprovalSteps   OvertimeApprovalStep[]
  timeAdjustApprovalSteps TimeAdjustApprovalStep[]

  @@unique([companyId, code])
  @@index([branchId])
  @@index([departmentId])
  @@index([employeeTypeId])
  @@index([targetType])
  @@index([status])
  @@index([deletedAt])
  @@map("approval_matrices")
}

model ApprovalMatrixRequester {
  id               String @id @default(cuid())
  approvalMatrixId String
  employeeId       String

  createdAt DateTime @default(now())

  approvalMatrix ApprovalMatrix @relation(fields: [approvalMatrixId], references: [id], onDelete: Cascade)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([approvalMatrixId, employeeId])
  @@index([employeeId])
  @@map("approval_matrix_requesters")
}

/// สาขาที่ใช้สายอนุมัติเส้นเดียวกัน
///
/// เดิมสายหนึ่งผูกได้สาขาเดียว (ApprovalMatrix.branchId) สาขาที่ใช้กติกาเหมือนกัน
/// จึงต้องสร้างสายซ้ำทีละสาขา แก้ทีต้องไล่แก้ทุกใบ
///
/// สาขาแรกยังเก็บที่ ApprovalMatrix.branchId เหมือนเดิม (ข้อมูลเก่าและการล็อก
/// สิทธิ์ผู้ดูแลระดับสาขาอิงช่องนั้นอยู่) ตารางนี้เก็บ "สาขาที่เพิ่มเข้ามา"
/// รายชื่อสาขาที่ใช้จริง = branchId + แถวในตารางนี้
model ApprovalMatrixBranch {
  id               String @id @default(cuid())
  approvalMatrixId String
  branchId         String

  createdAt DateTime @default(now())

  approvalMatrix ApprovalMatrix @relation(fields: [approvalMatrixId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([approvalMatrixId, branchId])
  @@index([branchId])
  @@map("approval_matrix_branches")
}

model ApprovalMatrixStep {
  id           String                   @id @default(cuid())
  matrixId     String
  stepNo       Int
  nameTh       String
  description  String?
  approverType ApprovalStepApproverType
  positionId   String?
  employeeId   String?
  roleCode     String?

  /// ผู้อนุมัติแทน เมื่อผู้อนุมัติหลักกลายเป็นคนยื่นเอง
  /// เช่น ขั้นนี้ตั้งเป็น "หัวหน้าโดยตรง" แล้วหัวหน้ายื่นใบลาของตัวเอง
  fallbackApproverType ApprovalStepApproverType?
  fallbackPositionId   String?
  fallbackEmployeeId   String?
  fallbackRoleCode     String?

  requireAll       Boolean      @default(false)
  minApproverCount Int          @default(1)
  status           MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  matrix   ApprovalMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  position Position?      @relation("ApprovalStepPosition", fields: [positionId], references: [id], onDelete: SetNull)
  employee Employee?      @relation("ApprovalStepEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  fallbackPosition        Position?                @relation("ApprovalStepFallbackPosition", fields: [fallbackPositionId], references: [id], onDelete: SetNull)
  fallbackEmployee        Employee?                @relation("ApprovalStepFallbackEmployee", fields: [fallbackEmployeeId], references: [id], onDelete: SetNull)
  leaveApprovalSteps      LeaveApprovalStep[]
  overtimeApprovalSteps   OvertimeApprovalStep[]
  timeAdjustApprovalSteps TimeAdjustApprovalStep[]

  @@unique([matrixId, stepNo])
  @@index([positionId])
  @@index([employeeId])
  @@index([fallbackPositionId])
  @@index([fallbackEmployeeId])
  @@index([roleCode])
  @@index([approverType])
  @@index([status])
  @@index([deletedAt])
  @@map("approval_matrix_steps")
}

model PaymentAccount {
  id            String  @id @default(cuid())
  companyId     String
  code          String
  bankName      String
  accountName   String
  accountNumber String
  branchName    String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([status])
  @@index([deletedAt])
}

model TaxMethod {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  nameTh      String
  nameEn      String?
  description String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([status])
  @@index([deletedAt])
}

model SocialInsuranceMethod {
  id          String  @id @default(cuid())
  companyId   String
  code        String
  nameTh      String
  nameEn      String?
  description String?

  status MasterStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([status])
  @@index([deletedAt])
}

/**
 * =========================
 * NOTIFICATIONS
 * =========================
 */

/**
 * ผู้ใช้ปิดแจ้งเตือนเข้ามือถือเป็นรายหมวดได้
 * เก็บเฉพาะแถวที่ผู้ใช้ "แตะแล้ว" — ไม่มีแถว = เปิดอยู่ ซึ่งเป็นค่าตั้งต้นที่
 * ถูกต้องสำหรับผู้ใช้ใหม่และสำหรับหมวดที่เพิ่มเข้ามาทีหลัง (ถ้าเก็บครบทุกหมวด
 * ตอนสมัคร หมวดใหม่จะกลายเป็น "ปิด" ให้คนเก่าทั้งหมดโดยไม่มีใครตั้งใจ)
 * ตัวนี้คุมแค่ **push เข้าเครื่อง** ไม่ได้คุมการแจ้งเตือนในระบบ — รายการใน
 * แอปยังขึ้นครบเสมอ ปิดไว้แค่ไม่ให้เด้งขึ้นจอล็อก
 */
model MobilePushPreference {
  id       String  @id @default(cuid())
  userId   String
  /**
   * หมวดตาม MobilePushCategory ฝั่งโค้ด — เก็บเป็น string ให้เพิ่มหมวดได้โดยไม่ต้อง migrate
   */
  category String
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("mobile_push_preferences")
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  sourceKey String

  title    String
  message  String
  type     String
  severity String @default("INFO")

  entityType String?
  entityId   String?
  link       String?
  count      Int     @default(1)
  metadata   Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, readAt])
  @@index([type])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/**
 * =========================
 * AUDIT LOG
 * =========================
 */

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entity      String
  entityId    String?
  description String?

  userId    String?
  requestId String?

  /// บริษัทที่การกระทำนี้เกิดขึ้น
  ///
  /// ยอมว่างได้เพราะแถวเดิมไม่มีค่านี้ และการกระทำระดับแพลตฟอร์ม
  /// (เช่นแอดมินระบบล็อกอิน) ไม่ได้ผูกกับบริษัทใดบริษัทหนึ่ง
  /// เดิมต้อง join ผ่าน User ทุกครั้งที่จะแยกว่าใครดูของบริษัทไหนได้
  companyId String?

  ipAddress  String?
  userAgent  String?
  method     String?
  path       String?
  statusCode Int?

  metadata Json?

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity, entityId])
  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@map("system_settings")
}

model SystemSettingAudit {
  id            String   @id
  settingId     String
  previousValue Json
  newValue      Json
  changedById   String?
  createdAt     DateTime @default(now())

  @@index([settingId])
  @@index([changedById])
  @@index([createdAt])
  @@map("system_settings_audit")
}

model CompanyPayrollSetting {
  id        String @id @default(cuid())
  companyId String @unique

  payrollCutoffDay      Int
  payrollPeriodStartDay Int
  salaryDivisorDays     Int
  workingHoursPerDay    Int

  socialSecurityEmployeeRate Decimal @db.Decimal(5, 2)
  socialSecurityEmployerRate Decimal @db.Decimal(5, 2)
  socialSecurityMinBase      Decimal @db.Decimal(14, 2)
  socialSecurityMaxBase      Decimal @db.Decimal(14, 2)

  /// ---- ภาษีของเงินก้อนที่จ่ายเมื่อออกจากงาน ----
  /// ตัวเลขตั้งต้นตามกฎกระทรวง ฉบับที่ 126 และมาตรา 48(5)
  /// แยกเป็นค่าตั้งค่าเพราะกฎกระทรวงแก้ได้โดยไม่ต้องแก้โค้ด

  /// จำนวนวันค่าจ้างสูงสุดที่ค่าชดเชยได้รับยกเว้นภาษี
  severanceTaxExemptMaxDays   Int     @default(300)
  /// เพดานเงินยกเว้นภาษีของค่าชดเชย
  severanceTaxExemptMaxAmount Decimal @default(300000) @db.Decimal(14, 2)
  /// ค่าใช้จ่ายที่หักได้ต่อปีที่ทำงาน ในใบแนบ ภ.ง.ด.90/91
  separationExpensePerYear    Decimal @default(7000) @db.Decimal(14, 2)
  /// อายุงานขั้นต่ำ (ปี) ที่แยกคำนวณภาษีเงินก้อนได้
  separationMinServiceYears   Int     @default(5)

  status MasterStatus @default(ACTIVE)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  severanceTiers SeverancePayTier[]

  @@index([companyId])
  @@index([status])
  @@map("company_payroll_settings")
}

/// บันไดค่าชดเชยตามอายุงาน (พ.ร.บ.คุ้มครองแรงงาน มาตรา 118)
/// เก็บเป็น master data เพราะบริษัทให้ดีกว่ากฎหมายได้ และกฎหมายเองก็แก้ได้
model SeverancePayTier {
  id        String @id @default(cuid())
  settingId String

  /// อายุงานขั้นต่ำเป็นเดือน ที่ได้ค่าชดเชยขั้นนี้
  minServiceMonths Int
  /// จำนวนวันค่าจ้างที่ได้รับ
  payDays          Int

  sortOrder Int          @default(0)
  status    MasterStatus @default(ACTIVE)
  note      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  setting CompanyPayrollSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, minServiceMonths])
  @@index([status])
  @@index([deletedAt])
  @@map("severance_pay_tiers")
}

model CompanyPayrollSettingAudit {
  id            String   @id @default(cuid())
  settingId     String
  companyId     String
  previousValue Json
  newValue      Json
  changedById   String?
  createdAt     DateTime @default(now())

  @@index([settingId])
  @@index([companyId])
  @@index([changedById])
  @@index([createdAt])
  @@map("company_payroll_settings_audit")
}

/**
 * =========================
 * PHASE 2 - EMPLOYEE MANAGEMENT
 * =========================
 */

model Employee {
  id String @id @default(cuid())

  /// รหัสพนักงาน — ห้ามซ้ำ "ภายในบริษัทเดียวกัน" (ดู @@unique ท้ายโมเดล)
  ///
  /// เดิมสคีมาประกาศเป็น @unique ทั้งระบบ แต่ฐานข้อมูลจริงเป็น UNIQUE(companyId, employeeCode)
  /// ถ้า deploy จากสคีมาไปเครื่องใหม่ จะได้ข้อจำกัดคนละแบบกับที่รันอยู่
  /// แล้วบริษัทที่สองจะสร้างพนักงานรหัส "001" ไม่ได้ (P2002)
  employeeCode String

  title       String?
  firstName   String
  lastName    String
  nickname    String?
  displayName String?
  email       String?
  phone       String?
  position    String?

  positionId     String?
  positionMaster Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  startDate         DateTime
  /// วันสุดท้ายของการเป็นพนักงาน เขียนตอนปิดเคสออกจากงาน
  /// payroll ใช้ค่านี้คิดเงินงวดสุดท้ายตามวันที่เป็นพนักงานจริง แทนการดูสถานะอย่างเดียว
  /// (ดูสถานะอย่างเดียวทำให้คนที่ออกกลางงวดหลุดจากงวดทั้งคนและได้ 0 บาท)
  employmentEndDate DateTime?
  probationEndDate  DateTime?
  /// วันที่ผ่านทดลองงาน (ระบบบันทึกให้ตอน HR รีวิวผ่านที่หน้า onboarding)
  probationPassedAt DateTime?
  status            EmployeeStatus @default(ACTIVE)

  companyId      String
  branchId       String?
  departmentId   String?
  divisionId     String?
  employeeTypeId String?
  userId         String? @unique

  // การตั้งค่าลงเวลา (รายพนักงาน)
  // allowedAttendanceMethods: วิธีที่อนุญาตให้ลงเวลาเอง (เว็บ/แอป/เครื่องสแกน)
  // attendanceGeofenceRequired: true = ต้องอยู่ในรัศมีจุดของสาขา (พนักงานประจำออฟฟิศ)
  //                             false = ลงเวลาได้ทุกที่ แต่ยังเก็บพิกัด (พนักงานออกนอกสถานที่)
  allowedAttendanceMethods   AttendanceMethod[] @default([WEB, MOBILE, DEVICE])
  attendanceGeofenceRequired Boolean            @default(true)

  /// false = ไม่ต้องลงเวลาเข้าออกเลย (ผู้บริหาร / พนักงานเหมาจ่าย)
  ///
  /// ต่างจากการยกเว้นรายช่วงตรงที่ตัวนี้ปิดการตรวจทั้งวัน — ไม่คิดสาย ไม่คิดขาดงาน
  /// ไม่คิดลืมสแกน และไม่มีค่าปรับใด ๆ คนกลุ่มนี้ได้ค่าจ้างเต็มตามสัญญาโดยไม่ผูกกับเวลา
  /// ถ้าไม่มีฟิลด์นี้ ระบบจะตีว่าขาดงานทุกวันที่ไม่มีการสแกน แล้วหักเงินทั้งเดือน
  attendanceTrackingRequired Boolean @default(true)

  /// ช่วงลงเวลาที่ยกเว้นเป็นรายคน เช่น พนักงานจัดส่งที่ออกไปทำงานข้างนอกตอนกลางวัน
  /// จึงไม่ต้องกลับมากดเข้างานบ่าย — ใส่ AFTERNOON_IN ไว้ในรายการนี้
  ///
  /// เก็บเป็น array แทน boolean แยกทีละช่วง เพื่อให้ยกเว้นช่วงอื่นได้ในอนาคต
  /// โดยไม่ต้องเพิ่มคอลัมน์ใหม่ทุกครั้ง
  attendanceExemptSessions AttendanceSessionCode[] @default([])

  /// ลำดับที่จัดไว้เองในกระดานผังองค์กร (น้อย = ขึ้นก่อน)
  ///
  /// 0 = ยังไม่เคยจัดมือ ปล่อยให้เรียงตามระดับตำแหน่งเหมือนเดิม
  /// พอกดเลื่อนขึ้น/ลงในกล่องแผนก ระบบจะไล่ให้เลข 10, 20, 30 … เฉพาะคนในกล่องนั้น
  sortOrder Int @default(0)

  supervisorId String?

  supervisor   Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("EmployeeSupervisor")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  division     Division?     @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  employeeType EmployeeType? @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  profile       EmployeeProfile?
  familyMembers EmployeeFamilyMember[]
  educations    EmployeeEducation[]
  documents     EmployeeDocument[]
  workHistories EmployeeWorkHistory[]
  resignations  EmployeeResignation[]

  transfers                 EmployeeTransfer[]
  transfersAsFromSupervisor EmployeeTransfer[] @relation("EmployeeTransferFromSupervisor")
  transfersAsToSupervisor   EmployeeTransfer[] @relation("EmployeeTransferToSupervisor")

  attendanceLogs              AttendanceLog[]
  attendanceDeviceEnrollments AttendanceDeviceEnrollment[]
  attendanceDeviceCommands    AttendanceDeviceCommand[]
  attendanceDailySummaries    AttendanceDailySummary[]
  workShifts                  EmployeeWorkShift[]
  leaveBalances               LeaveBalance[]
  leaveRequests               LeaveRequest[]
  overtimeRequests            OvertimeRequest[]

  timeAdjustRequests TimeAdjustRequest[]

  documentRequests DocumentRequest[]
  complaints       Complaint[]

  evaluationResults EvaluationResult[]
  evaluatedResults  EvaluationResult[] @relation("EvaluationResultEvaluator")

  warningLetters        WarningLetter[]
  disciplinaryHistories DisciplinaryHistory[]

  onboardingTasks     OnboardingTask[]
  onboardingDocuments OnboardingDocument[]
  probationRecords    ProbationRecord[]

  offboardingCases OffboardingCase[]
  offboardingTasks OffboardingTask[]

  jobApplication JobApplication? @relation("JobApplicationHiredEmployee")

  compensations  EmployeeCompensation[]
  payrollItems   PayrollItem[]
  deductionPlans EmployeeDeductionPlan[]

  taxProfiles      EmployeeTaxProfile[]
  taxYearSummaries EmployeeTaxYearSummary[]
  taxCalculations  PayrollTaxCalculation[]

  approvalSteps                   ApprovalMatrixStep[]      @relation("ApprovalStepEmployee")
  approvalFallbackSteps           ApprovalMatrixStep[]      @relation("ApprovalStepFallbackEmployee")
  approvalMatrixRequesterScopes   ApprovalMatrixRequester[]
  expectedLeaveApprovalSteps      LeaveApprovalStep[]       @relation("LeaveApprovalStepExpectedEmployee")
  expectedOvertimeApprovalSteps   OvertimeApprovalStep[]    @relation("OvertimeApprovalStepExpectedEmployee")
  expectedTimeAdjustApprovalSteps TimeAdjustApprovalStep[]  @relation("TimeAdjustApprovalStepExpectedEmployee")

  evaluatorTargetAssignments   Evaluator[] @relation("EvaluatorTargetEmployee")
  evaluatorEmployeeAssignments Evaluator[] @relation("EvaluatorEmployee")

  @@unique([companyId, employeeCode])
  @@index([employeeCode])
  @@index([firstName, lastName])
  @@index([branchId])
  @@index([departmentId])
  @@index([divisionId])
  @@index([employeeTypeId])
  @@index([positionId])
  @@index([supervisorId])
  @@index([status])
  @@index([deletedAt])
  @@index([employmentEndDate])
  @@index([companyId, branchId, departmentId, status, deletedAt], map: "idx_hr_review_employee_scope")
  @@map("employees")
}

model EmployeeProfile {
  id         String @id @default(cuid())
  employeeId String @unique

  /// สำเนา companyId ของพนักงาน — มีไว้เพื่อบังคับ "ห้ามเลขซ้ำภายในบริษัทเดียวกัน"
  ///
  /// Postgres สร้าง unique index ข้ามตารางไม่ได้ ถ้าจะกันเลขบัตร/เลขประกันสังคมซ้ำ
  /// ต้องมีคอลัมน์บริษัทอยู่ในตารางเดียวกันกับเลขนั้น
  /// ไม่บังคับ unique ทั้งระบบ เพราะคนเดียวทำงานหลายบริษัทในเครือได้จริง
  /// ต้องอัปเดตตามเมื่อพนักงานย้ายบริษัท (ดู employees.service)
  companyId String

  gender        Gender        @default(NOT_SPECIFIED)
  birthDate     DateTime?
  nationalId    String?
  passportNo    String?
  maritalStatus MaritalStatus @default(NOT_SPECIFIED)
  nationality   String?
  religion      String?

  currentAddress    String?
  registeredAddress String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  /// ผู้ติดต่อฉุกเฉินคนที่สอง — คนแรกติดต่อไม่ได้ก็ยังมีอีกทาง
  /// เก็บเป็นคอลัมน์ชุดที่สองแทนตารางแยก เพราะของจริงใช้แค่สองคนและ
  /// ทุกที่ที่อ่านโปรไฟล์อยู่แล้ว (HR / ESS / มือถือ) จะได้ไม่ต้อง join เพิ่ม
  emergencyContactName2     String?
  emergencyContactPhone2    String?
  emergencyContactRelation2 String?

  educationLevel     String?
  educationInstitute String?
  educationMajor     String?

  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  // International HR master data / compliance readiness
  firstNameEn String?
  lastNameEn  String?

  personalEmail String?
  workPhoneExt  String?
  lineId        String?
  bloodType     String?

  taxId                  String?
  socialSecurityNo       String?
  socialSecurityHospital String?
  providentFundNo        String?
  payrollPaymentMethod   String?

  contractNo        String?
  contractStartDate DateTime?
  contractEndDate   DateTime?
  workLocation      String?

  workPermitNo          String?
  workPermitExpiredDate DateTime?
  visaNo                String?
  visaExpiredDate       DateTime?

  emergencyContactAddress  String?
  emergencyContactAddress2 String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /**
   * เดิมบังคับ @@unique([companyId, nationalId/socialSecurityNo/taxId]) ไว้ตรงนี้
   * ถอดออกเพราะบริษัทเดียวในระบบนี้มีหลายสาขาที่จริง ๆ แล้วเป็นคนละนิติบุคคล
   * ผู้บริหารที่รับเงินเดือนจากสองสาขาต้องมีทะเบียนพนักงานคนละใบต่อสาขา (คนละรหัส)
   * แต่เป็นคนคนเดียวกัน จึงต้องใส่เลขบัตร/เลขภาษี/เลขประกันสังคมชุดเดียวกันได้ทั้งสองใบ
   * ถ้ายังบังคับ unique อยู่ ทะเบียนใบที่สองจะกรอกเลขไม่ได้เลย แล้วออก ภ.ง.ด.1 ไม่ได้
   * เพราะไม่มีเลขประจำตัวผู้เสียภาษี (ข้อมูลเก่าบางคนถึงมี nationalId ว่างอยู่)
   * แลกมาด้วยการที่ระบบไม่กันการคีย์คนซ้ำโดยพลาดให้อีกต่อไป — ตั้งใจแลก
   * เพราะแยกไม่ออกว่า "เลขซ้ำ" คือคนเดิมที่อีกสาขา หรือคีย์ผิด
   */
  @@index([companyId])
  @@index([nationalId])
  @@index([taxId])
  @@index([socialSecurityNo])
  @@map("employee_profiles")
}

model EmployeeDocument {
  id         String @id @default(cuid())
  employeeId String

  type        EmployeeDocumentType
  title       String
  description String?

  fileName String
  fileSize Int?
  mimeType String?

  storageProvider String  @default("LOCAL")
  storageKey      String
  bucketName      String?

  issuedDate  DateTime?
  expiredDate DateTime?
  status      EmployeeDocumentStatus @default(ACTIVE)

  uploadedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
