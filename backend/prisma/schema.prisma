  morningCheckInDeadline   String @default("08:00")
  afternoonCheckInDeadline String @default("13:00")
  checkoutAllowedFrom      String @default("17:00")

  latePenaltyRatePerMinute Decimal @default(5) @db.Decimal(14, 2)
