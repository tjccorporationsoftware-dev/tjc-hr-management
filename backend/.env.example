# =============================================================================
# ค่าตั้งต้นของ backend — ไฟล์เดียวครอบทุกสภาพแวดล้อม
# =============================================================================
# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับเครื่องที่รัน
#
#   cp .env.example .env
#   npm run gen:secrets     # สุ่มค่าลับ เอาไปวางแทนค่าตัวอย่าง
#   npm run check:prod      # ตรวจก่อนเปิดใช้จริง ต้องผ่านทุกข้อ
#
# ค่าที่เขียนไว้ในไฟล์นี้คือค่าสำหรับ **เครื่องพัฒนา** ใช้ได้ทันทีโดยไม่ต้องแก้
# ตอนขึ้นระบบจริงให้ดูตารางข้างล่าง — มีแค่ 12 ตัวที่ต้องเปลี่ยน ที่เหลือใช้ค่าเดิมได้
#
# ค่าที่ทำเครื่องหมาย [บังคับ] ถ้าไม่ตั้ง เซิร์ฟเวอร์จะไม่ยอมบูต
# (กติกาทั้งหมดอยู่ที่ src/config/env.validation.ts)
#
# บน NODE_ENV=production มีกติกาเพิ่ม เช่น ห้ามใช้ค่าลับที่เดาง่าย
# ห้ามชี้ FRONTEND_URL ไป localhost และ cookie ต้องเป็น secure
#
# **ห้ามเติมค่าจริงลงไฟล์นี้** ไฟล์นี้ถูก git ตามอยู่ ส่วน .env ถูก ignore ไว้แล้ว
#
#
# -----------------------------------------------------------------------------
# ค่าที่ต้องเปลี่ยนตอนขึ้นระบบจริง
# -----------------------------------------------------------------------------
#
#                            | Docker (Linux)          | ลงตรงบน Windows
#   -------------------------|-------------------------|----------------------
#   NODE_ENV                 | production              | production
#   FRONTEND_URL             | https://<โดเมนลูกค้า>    | เหมือนกัน
#   DATABASE_URL   โฮสต์     | postgres:5432           | 127.0.0.1:5432
#   REDIS_HOST               | ไม่ต้องตั้ง (QUEUE_DRIVER=memory)              |
#   COOKIE_SECURE            | true                    | true
#   TRUST_PROXY              | true                    | true
#   JWT_ACCESS_SECRET        | สุ่มใหม่ 64 ตัว           | เหมือนกัน
#   JWT_REFRESH_SECRET       | สุ่มใหม่ คนละค่ากับข้างบน | เหมือนกัน
#   SEED_ADMIN_PASSWORD      | ตั้งเอง ≥24 ตัว          | เหมือนกัน
#   MONITORING_METRICS_TOKEN | สุ่ม 48 ตัว              | เหมือนกัน
#   POSTGRES_CONTAINER_NAME  | hr_postgres_prod        | ปล่อยว่าง (ไม่มี Docker)
#   PUPPETEER_EXECUTABLE_PATH| /usr/bin/chromium       | ปล่อยว่าง (ใช้ Chrome ของตัวเอง)
#
#   เส้นทางเก็บไฟล์ (UPLOAD_DIR / STORAGE_DIR / BACKUP_DIR / CLEANUP_LOG_DIR)
#   Docker ใช้ /app/... ตามที่ mount ไว้ · Windows ใช้เส้นทางแบบ D:\hr\...
#
#   ดูขั้นตอนเต็มที่ DEPLOYMENT.md (Docker) หรือ DEPLOYMENT-WINDOWS.md
# =============================================================================


# --- พื้นฐาน ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# เขตเวลาของกระบวนการ — ตั้งเป็นเวลาไทยเสมอ
# คอนเทนเนอร์ Linux ส่วนใหญ่เป็น UTC ทำให้ log และค่าที่พึ่งเวลาเซิร์ฟเวอร์คลาด 7 ชั่วโมง
TZ=Asia/Bangkok

# [บังคับ] ที่อยู่ของหน้าเว็บ ใช้ทั้ง CORS และลิงก์ในอีเมล
# production ห้ามเป็น localhost
FRONTEND_URL=http://localhost:3000

# อยู่หลัง reverse proxy (nginx / cloud load balancer) หรือไม่
# true = เชื่อ X-Forwarded-* ตั้งเป็น true เฉพาะเมื่อมี proxy จริง
# ไม่งั้นผู้ใช้ปลอม IP ตัวเองเพื่อเลี่ยงการจำกัดจำนวนครั้งได้
TRUST_PROXY=false

# เพดานขนาด request body
REQUEST_BODY_LIMIT=2mb


# --- ฐานข้อมูล ----------------------------------------------------------------

# [บังคับ]
DATABASE_URL=postgresql://hr_admin:hr_password@localhost:5433/hr_workforce?schema=public

# ชื่อคอนเทนเนอร์ postgres — สคริปต์ backup/restore ใช้เรียก pg_dump ข้างใน
# ลงตรงบน Windows ให้ปล่อยว่าง แล้วใช้ scripts\windowsackup.ps1 แทน
POSTGRES_CONTAINER_NAME=hr_postgres


# --- ความปลอดภัย / โทเคน -------------------------------------------------------

# [บังคับ] ต้องยาวพอและเดาไม่ได้ สร้างด้วย: openssl rand -base64 48
# ห้ามใช้ค่าเดียวกันทั้งสองตัว และห้ามใช้ค่าตัวอย่างนี้บนระบบจริง
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# cookie ของ refresh token ต้องวิ่งบน HTTPS เท่านั้น
# ปล่อยว่างให้ระบบตัดสินจาก NODE_ENV · production บังคับเป็น true
COOKIE_SECURE=

# ล็อกบัญชีเมื่อรหัสผิดติดกันกี่ครั้ง และล็อกนานกี่นาที
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- ยืนยันตัวตนสองชั้น (2FA) ---------------------------------------------------
#
# ปิดทั้งระบบไว้ก่อน เพราะยังไม่มีช่องทางส่งรหัสให้ผู้ใช้จริง
# (ไม่มีทั้ง TOTP, อีเมล และ SMS — รหัสถูกส่งกลับผ่าน response ตอน dev เท่านั้น)
# เปิดตอนนี้ = ผู้ใช้ที่เข้าเงื่อนไขล็อกอินไม่ได้ถาวร ต้องไปแก้ที่ฐานข้อมูล
#
# บน production เซิร์ฟเวอร์จะไม่ยอมบูตถ้าตั้งเป็น true (ดู config/env.validation.ts)
# เปิดคืนได้เมื่อทำ OTP delivery เสร็จ — แผนคือ TOTP/Authenticator app
TWO_FACTOR_ENABLED=false

# ค่าด้านล่างมีผลก็ต่อเมื่อ TWO_FACTOR_ENABLED=true
TWO_FACTOR_CODE_EXPIRES_MINUTES=10
# บทบาทที่บังคับใช้ 2FA คั่นด้วยจุลภาค
TWO_FACTOR_REQUIRED_ROLE_CODES=SYSTEM_ADMIN
# true = โชว์รหัส OTP ใน response (ใช้ตอนพัฒนาเท่านั้น) production ห้ามเปิด
TWO_FACTOR_DEV_SHOW_CODE=false


# --- คิวงาน --------------------------------------------------------------------
#
# ระบบมีคิวงานสี่ตัว — คำนวณเวลาใหม่ · ออกรายงาน · งานบำรุงรักษา · งานฝั่งมือถือ
#
#   memory (ค่าเริ่มต้น)  คิวในโปรเซสเดียวกับตัวแอป **ไม่ต้องมี Redis**
#   redis                 BullMQ + Redis แบบเดิม
#
# ใช้ memory ได้เพราะระบบรัน backend ตัวเดียว ซึ่งเป็นเงื่อนไขเดียวที่ทำให้
# คิวข้ามโปรเซสจำเป็น สถานะงานจริงถูกเก็บใน PostgreSQL อยู่แล้ว งานที่ค้าง
# ตอนรีสตาร์ตจึงถูกกวาดกลับเข้าคิวให้เองตอนบูต
#
# **ถ้าวันหนึ่งต้องรัน backend หลายตัว ต้องเปลี่ยนเป็น redis** ไม่งั้นแต่ละตัว
# จะมีคิวของตัวเองแยกกัน และงานตามตารางจะยิงซ้ำเท่าจำนวน instance
QUEUE_DRIVER=memory

# ค่าด้านล่างใช้เมื่อ QUEUE_DRIVER=redis เท่านั้น
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ทั้งสองตัวนี้ค่าเริ่มต้นเดินตาม QUEUE_DRIVER — ไม่ต้องตั้งเองในกรณีปกติ
# ตั้งเป็น true พร้อมกับ QUEUE_DRIVER=redis ถ้าอยากใช้ Redis นับจำนวนครั้งล็อกอิน
# และให้ health check ตรวจ Redis ด้วย
# RATE_LIMIT_REDIS_ENABLED=false
# MONITORING_REDIS_CHECK_ENABLED=false


# --- ที่เก็บไฟล์ ---------------------------------------------------------------
#
# ระบบเก็บไฟล์ลงดิสก์ ไม่ได้ใช้ object storage (เคยมี MinIO ใน compose
# แต่ไม่มีโค้ดเรียกใช้เลย จึงถอดออกแล้ว)
#
# สำคัญ: ทั้งหมดนี้เป็นโฟลเดอร์บน "ดิสก์ของเครื่องที่รัน"
# ถ้ารันหลาย instance ต้อง mount เป็น volume ที่ใช้ร่วมกัน
# ไม่งั้นไฟล์ที่อัปโหลดผ่าน instance หนึ่งจะหาไม่เจอจากอีก instance

# ไฟล์แนบที่ผู้ใช้อัปโหลด (ใบลา / OT / เอกสารพนักงาน)
UPLOAD_DIR=uploads
# ไฟล์ของระบบ เช่นโลโก้บริษัท
STORAGE_DIR=storage
# ไฟล์ที่ระบบสร้างให้ดาวน์โหลด (Excel / PDF)
EXPORT_STORAGE_DIR=storage/exports
# ไฟล์ชั่วคราวระหว่างประมวลผล
TEMP_STORAGE_DIR=storage/temp

TEMP_FILE_KEEP_DAYS=1
EXPORT_FILE_KEEP_DAYS=7
GENERAL_STORAGE_KEEP_DAYS=30


# --- สำรองข้อมูล ---------------------------------------------------------------

BACKUP_DIR=../backups
BACKUP_KEEP_DAYS=14
# true = สำรองไฟล์ที่ผู้ใช้อัปโหลดด้วย ไม่ใช่แค่ฐานข้อมูล
BACKUP_INCLUDE_STORAGE=true

CLEANUP_LOG_DIR=../cleanup-logs
CLEANUP_DRY_RUN_DEFAULT=false
CLEANUP_STORAGE_ENABLED=true


# --- ออกเอกสาร PDF -------------------------------------------------------------
#
# สลิปเงินเดือนและหนังสือรับรองออกเป็น PDF ด้วย Puppeteer
# อิมเมจ node ไม่มี Chromium มาให้ ถ้าไม่ตั้งค่านี้จะพังตอนกดออกเอกสาร
# ไม่ใช่ตอนบูต — จึงไม่มีอะไรเตือนจนกว่าจะมีคนใช้จริง
# บน Windows ปล่อยว่าง — puppeteer โหลด Chrome ของตัวเองมาตอน npm ci อยู่แล้ว
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# --- เครื่องสแกนลายนิ้วมือ / บัตร ----------------------------------------------
#
# โทเคนที่ต้องแนบมากับข้อมูลลงเวลาที่ยิงเข้า /iclock/*
# **ไม่ตั้ง = ปฏิเสธข้อมูลจากเครื่องสแกนทั้งหมด** โดยไม่มีอะไรเตือนที่หน้าเว็บ
# ถ้ายังไม่ใช้เครื่องสแกน ปล่อยว่างได้ แต่ต้องรู้ว่าปล่อยไว้ทำไม
#
# ตัวเครื่องแนบเองไม่ได้ (ตั้งได้แค่ที่อยู่กับพอร์ต) ต้องมี nginx คั่นหน้าเติมให้
# ดู infra/nginx/README.md — ค่าต้องตรงกับ .env ที่โฟลเดอร์บนสุดด้วย
# ต้องยาว ≥24 ตัวบน production สุ่มได้จาก `npm run gen:secrets`
ATTENDANCE_DEVICE_PUSH_TOKEN=

# จำกัด IP ต้นทางที่ยิง /iclock/* ได้ คั่นด้วยจุลภาค เทียบแบบลงท้ายตรงกัน
# ปล่อยว่าง = ไม่จำกัด (ยังต้องผ่านโทเคนอยู่)
# ต้องตั้ง TRUST_PROXY=true ด้วยเมื่ออยู่หลัง nginx ไม่งั้นเห็นแต่ IP ของ proxy
# ทุกคำขอ — ตั้ง allowlist ไปก็ไม่มีผลอะไร
# ตัวอย่าง: ATTENDANCE_DEVICE_PUSH_ALLOWED_IPS=192.168.1.50,192.168.1.51
ATTENDANCE_DEVICE_PUSH_ALLOWED_IPS=


# --- การเฝ้าระวัง --------------------------------------------------------------

# โทเคนสำหรับดึง /monitoring/metrics ปล่อยว่าง = ปิดการเข้าถึงจากภายนอก
MONITORING_METRICS_TOKEN=
MONITORING_REDIS_CHECK_ENABLED=true

# true = เขียนบันทึกการเปิดดูข้อมูลลง audit log ด้วย
AUDIT_VIEW_ENABLED=true


# --- ข้อมูลตั้งต้น (seed) ------------------------------------------------------
#
# บน NODE_ENV=production ถ้าไม่ตั้งรหัสผ่านเหล่านี้ seed จะไม่ยอมรัน
# เพื่อกันไม่ให้มีบัญชีรหัสผ่านตั้งต้นหลุดขึ้นระบบจริง

SEED_ADMIN_EMAIL=superadmin@tjc.local
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=


# --- ลิงก์ดาวน์โหลดแอปมือถือ ---------------------------------------------------

MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_STORE_URL=
