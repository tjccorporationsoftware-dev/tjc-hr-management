# ค่าตั้งต้นของ backend — คัดลอกเป็น .env แล้วแก้ให้ตรงกับเครื่องที่รัน
# ค่าที่เขียนไว้คือค่าสำหรับเครื่องพัฒนา ใช้ได้ทันที · ขึ้นระบบจริงดู DEPLOYMENT-WINDOWS.md
#   npm run gen:secrets   สุ่มค่าลับ     npm run check:prod   ตรวจก่อนเปิดใช้จริง
# [บังคับ] = ไม่ตั้งแล้วเซิร์ฟเวอร์ไม่ยอมบูต (กติกาอยู่ที่ src/config/env.validation.ts)
# ห้ามเติมค่าจริงลงไฟล์นี้ — ไฟล์นี้ขึ้น git ส่วน .env ถูก ignore ไว้แล้ว


# --- พื้นฐาน ------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# ตั้งเป็นเวลาไทยเสมอ เครื่องที่เป็น UTC จะทำให้ค่าที่พึ่งเวลาเซิร์ฟเวอร์คลาด 7 ชั่วโมง
TZ=Asia/Bangkok

# trace / debug / info / warn / error / fatal · ว่าง = production ใช้ info, dev ใช้ debug
LOG_LEVEL=

# [บังคับ] ที่อยู่หน้าเว็บ ใช้ทำ CORS · production ต้องเป็น https ห้าม localhost
FRONTEND_URL=http://localhost:3000

# true เมื่ออยู่หลัง reverse proxy เท่านั้น ไม่งั้นผู้ใช้ปลอม IP เลี่ยง rate limit ได้
TRUST_PROXY=false

REQUEST_BODY_LIMIT=2mb


# --- ฐานข้อมูล ----------------------------------------------------------------

# [บังคับ] รหัสผ่านที่มี @ : / ? ต้อง percent-encode ก่อนใส่
DATABASE_URL=postgresql://hr_admin:hr_password@localhost:5433/hr_workforce?schema=public

# ชื่อคอนเทนเนอร์ postgres ที่สคริปต์ backup เรียก pg_dump ข้างใน · ไม่ใช้ Docker ปล่อยว่าง
POSTGRES_CONTAINER_NAME=hr_postgres


# --- ความปลอดภัย / โทเคน -------------------------------------------------------

# [บังคับ] สุ่มด้วย npm run gen:secrets · ห้ามใช้ค่าเดียวกันสองตัว และห้ามใช้ค่าตัวอย่างนี้
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# cookie ของ refresh token · ว่าง = ตัดสินจาก NODE_ENV, production บังคับ true
COOKIE_SECURE=

# ล็อกบัญชีเมื่อรหัสผิดติดกันกี่ครั้ง และล็อกนานกี่นาที
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15


# --- ยืนยันตัวตนสองชั้น (2FA) ---------------------------------------------------

# ปิดไว้ก่อน เพราะยังไม่มีช่องทางส่งรหัสจริง (production บูตไม่ขึ้นถ้าตั้ง true)
TWO_FACTOR_ENABLED=false

# สามตัวนี้มีผลเมื่อ TWO_FACTOR_ENABLED=true เท่านั้น · DEV_SHOW_CODE ห้ามเปิดบน production
TWO_FACTOR_CODE_EXPIRES_MINUTES=10
TWO_FACTOR_REQUIRED_ROLE_CODES=SYSTEM_ADMIN
TWO_FACTOR_DEV_SHOW_CODE=false


# --- คิวงาน --------------------------------------------------------------------

# memory = คิวในโปรเซสเดียวกับแอป ไม่ต้องมี Redis · ถ้ารัน backend หลายตัวต้องใช้ redis
QUEUE_DRIVER=memory

# ใช้เมื่อ QUEUE_DRIVER=redis เท่านั้น
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ปกติเดินตาม QUEUE_DRIVER เอง เปิดพร้อม redis ถ้าอยากให้ rate limit และ health check ใช้ด้วย
# RATE_LIMIT_REDIS_ENABLED=false
# MONITORING_REDIS_CHECK_ENABLED=false


# --- ที่เก็บไฟล์ ---------------------------------------------------------------

# เก็บลงดิสก์ของเครื่องที่รัน · รันหลาย instance ต้อง mount เป็น volume ร่วมกัน
UPLOAD_DIR=uploads
STORAGE_DIR=storage
EXPORT_STORAGE_DIR=storage/exports
TEMP_STORAGE_DIR=storage/temp

TEMP_FILE_KEEP_DAYS=1
EXPORT_FILE_KEEP_DAYS=7
GENERAL_STORAGE_KEEP_DAYS=30


# --- สำรองข้อมูล ---------------------------------------------------------------

BACKUP_DIR=../backups
BACKUP_KEEP_DAYS=14
# true = สำรองไฟล์ที่ผู้ใช้อัปโหลดด้วย ไม่ใช่แค่ฐานข้อมูล
BACKUP_INCLUDE_STORAGE=true

CLEANUP_LOG_DIR=../cleanup-logs
CLEANUP_DRY_RUN_DEFAULT=false
CLEANUP_STORAGE_ENABLED=true


# --- ออกเอกสาร PDF -------------------------------------------------------------

# ที่อยู่ Chromium ของ Puppeteer · บน Windows ปล่อยว่าง (npm ci โหลด Chrome มาให้แล้ว)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# --- เครื่องสแกนลายนิ้วมือ / บัตร ----------------------------------------------

# โทเคนที่ต้องแนบมากับ /iclock/* · ไม่ตั้ง = ปฏิเสธข้อมูลจากเครื่องสแกนทั้งหมดเงียบ ๆ
# เครื่องแนบเองไม่ได้ ต้องมี nginx คั่นหน้าเติมให้ (infra/nginx/README.md) · production ≥24 ตัว
ATTENDANCE_DEVICE_PUSH_TOKEN=

# จำกัด IP ต้นทางของ /iclock/* คั่นด้วยจุลภาค · ว่าง = ไม่จำกัด (ยังต้องผ่านโทเคน)
ATTENDANCE_DEVICE_PUSH_ALLOWED_IPS=


# --- การเฝ้าระวัง --------------------------------------------------------------

# โทเคนดึง /monitoring/metrics · ว่าง = ปิดการเข้าถึงจากภายนอก · production ต้อง ≥32 ตัว
MONITORING_METRICS_TOKEN=
MONITORING_REDIS_CHECK_ENABLED=true

# true = เขียนบันทึกการเปิดดูข้อมูลลง audit log ด้วย
AUDIT_VIEW_ENABLED=true


# --- ข้อมูลตั้งต้น (seed) ------------------------------------------------------

# บน production ถ้าไม่ตั้งรหัสผ่านสองตัวล่าง seed จะไม่ยอมรัน กันบัญชีรหัสตั้งต้นหลุด
SEED_ADMIN_EMAIL=superadmin@tjc.local
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=


# --- ลิงก์ดาวน์โหลดแอปมือถือ ---------------------------------------------------

MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_STORE_URL=
