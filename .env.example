# =============================================================================
# ค่าที่ docker-compose.prod.yml อ่าน — คัดลอกเป็น .env ที่โฟลเดอร์นี้
# =============================================================================
#
#   cp .env.example .env
#
# คนละไฟล์กับ backend/.env ซึ่งเป็นค่าตั้งของตัวแอป
# ไฟล์นี้มีเฉพาะค่าที่ compose ต้องใช้ตอนสร้างคอนเทนเนอร์
#
# ดูขั้นตอนเต็มที่ DEPLOYMENT.md
# =============================================================================


# --- ฐานข้อมูล ----------------------------------------------------------------
# รหัสผ่านต้อง **ตรงกับที่อยู่ใน DATABASE_URL ของ backend/.env**
# ไม่ตรงกัน = คอนเทนเนอร์ backend ต่อฐานข้อมูลไม่ได้ ทั้งที่ postgres ขึ้นปกติ
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=
POSTGRES_DB=hr_workforce


# --- ที่อยู่ API ที่หน้าเว็บเรียก ------------------------------------------------------
# **ฝังลงบันเดิลตอน build** เปลี่ยนตอนรันไม่ได้ ต้อง build frontend ใหม่
# ต้องเป็นที่อยู่ที่เบราว์เซอร์ของผู้ใช้เรียกถึงได้ ไม่ใช่ชื่อ service ใน compose
NEXT_PUBLIC_API_BASE_URL=https://<<<โดเมน>>>/api


# --- เครื่องสแกนลายนิ้วมือ --------------------------------------------------------
# โทเคนที่ตัวคั่นหน้า (service device-proxy) เติมให้เครื่องสแกน
# **ต้องตรงกับ ATTENDANCE_DEVICE_PUSH_TOKEN ใน backend/.env เป๊ะ ๆ**
# ไม่ตรงกัน = ข้อมูลลงเวลาถูกปฏิเสธ 401 โดยไม่มีอะไรเตือนที่หน้าเว็บ
# ยังไม่ใช้เครื่องสแกน = ลบ service device-proxy ออกจาก docker-compose.prod.yml
ATTENDANCE_DEVICE_PUSH_TOKEN=
