# =============================================================================
# ช่องรับข้อมูลจากเครื่องสแกนลายนิ้วมือ — สำหรับติดตั้งบน Windows Server (ไม่ใช้ Docker)
# =============================================================================
#
# เอาบล็อกนี้ไปต่อท้าย Caddyfile ตัวเดียวกับที่ทำ HTTPS ให้หน้าเว็บ
# (ดู DEPLOYMENT-WINDOWS.md หัวข้อ 7) แล้ว reload caddy
#
# ทำไมต้องมี:
# backend บังคับให้คำขอที่เข้า /iclock/* แนบ shared secret มาด้วย
# (backend/src/common/guards/device-push.guard.ts) แต่เครื่องสแกนตั้งค่าได้แค่
# "ที่อยู่เซิร์ฟเวอร์ + พอร์ต" ใส่ header หรือ query string เองไม่ได้
# บล็อกนี้จึงรับจากเครื่องแล้วเติม header ให้ก่อนส่งเข้า backend
#
# ถ้าไม่ทำ ทางเลือกที่เหลือคือปล่อย /iclock/* ไว้โดยไม่ตรวจโทเคน =
# ใครยิงถึงพอร์ตนั้นได้ สร้างรายการลงเวลาปลอมให้พนักงานคนไหนก็ได้
# =============================================================================

# พอร์ตที่ตั้งในเครื่องสแกน — HTTP ล้วน ไม่มี TLS เพราะเครื่องต่อ TLS ไม่ได้
# **เปิด Windows Firewall ให้พอร์ตนี้เฉพาะ IP ของเครื่องสแกนเท่านั้น**
# ห้ามเปิดออกอินเทอร์เน็ตเด็ดขาด
:8080 {
	# แยก log ของเครื่องสแกนไว้ต่างหาก เวลาไล่ปัญหาจะได้ไม่ปนกับ traffic หน้าเว็บ
	log {
		output file C:/hr-management/logs/attendance-device.log
	}

	handle /iclock/* {
		reverse_proxy 127.0.0.1:4000 {
			# หัวใจของบล็อกนี้ — เติมโทเคนแทนเครื่องที่ตั้ง header เองไม่ได้
			# ต้องเป็นค่าเดียวกับ ATTENDANCE_DEVICE_PUSH_TOKEN ใน backend/.env
			# ไม่ตรงกัน = backend ตอบ 401 ข้อมูลลงเวลาไม่เข้าและไม่มีอะไรเตือนที่หน้าเว็บ
			header_up x-device-token "<<<ATTENDANCE_DEVICE_PUSH_TOKEN>>>"

			# Caddy ใส่ X-Forwarded-For ให้อยู่แล้ว แต่ต้องตั้ง TRUST_PROXY=true
			# ใน backend/.env ด้วย ไม่งั้น ATTENDANCE_DEVICE_PUSH_ALLOWED_IPS
			# จะเห็นแต่ IP ของ Caddy ทุกคำขอ ตั้ง allowlist ไปก็ไม่มีผล
		}
	}

	# ทุกอย่างที่ไม่ใช่ /iclock/* ตัดทิ้งเงียบ ๆ — พอร์ตนี้เปิดไว้ให้เครื่องสแกนอย่างเดียว
	handle {
		abort
	}
}
