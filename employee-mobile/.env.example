# Environment ของแอป: development | preview | staging | production
EXPO_PUBLIC_APP_ENV=development

# Base URL ของ Backend รวม prefix /api
# ห้ามชี้ไป production จากเครื่อง dev
#
# หมายเหตุ Android emulator: localhost คือตัว emulator เอง ให้ใช้ 10.0.2.2 แทน
# เครื่องจริงที่ต่อ Wi-Fi เดียวกัน: ใช้ IP ของเครื่องที่รัน backend เช่น http://192.168.1.10:4000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Sentry DSN — เว้นว่างได้ ถ้าไม่ใส่แอปทำงานปกติทุกอย่างแต่ไม่มีรายงาน crash
#
# DSN ไม่ใช่ความลับ (ฝังอยู่ในแอปที่แจกออกไปอยู่แล้ว) แต่ auth token
# สำหรับอัปโหลด source map เป็นความลับ ตั้งใน EAS เป็น SENTRY_AUTH_TOKEN
# พร้อม SENTRY_ORG และ SENTRY_PROJECT ห้าม commit ลงไฟล์
#
# แนะนำให้ตั้งเฉพาะ preview/staging/production ไม่ต้องตั้งตอน dev
# ไม่งั้น error ระหว่างเขียนโค้ดจะไปกวนรายงานของจริง
EXPO_PUBLIC_SENTRY_DSN=
