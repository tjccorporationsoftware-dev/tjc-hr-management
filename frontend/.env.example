# =============================================================================
# ค่าตั้งต้นของหน้าเว็บ
# =============================================================================
#   cp .env.example .env.local        # ตอนพัฒนา
#   cp .env.example .env.production   # ตอนขึ้นระบบจริง
#
# **ห้ามเติมค่าจริงลงไฟล์นี้** ไฟล์นี้ถูก git ตามอยู่
# =============================================================================


# [บังคับ] ที่อยู่ API ที่เบราว์เซอร์ของผู้ใช้เรียกถึง
#
# **ค่านี้ถูกฝังลงบันเดิลตอน `npm run build` เปลี่ยนตอนรันไม่ได้**
# ตั้งผิดแล้วอาการคือหน้าเว็บขึ้นปกติแต่กดอะไรก็ error — ต้อง build ใหม่เท่านั้น
#
# ต้องเป็นที่อยู่ที่ "เบราว์เซอร์" เรียกถึง ไม่ใช่ชื่อ service ใน compose
# ผิด : http://backend:4000/api      (เบราว์เซอร์ไม่รู้จักชื่อนี้)
# ถูก : https://hr.ตัวอย่าง.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api


# ทดสอบบนมือถือในวงแลนเดียวกัน — ใส่ IP หรือ hostname เพิ่ม คั่นด้วยจุลภาค
# ไม่ใส่ = dev server ตอบ 403 ให้ทุกคำขอที่ไม่ได้มาจาก localhost
NEXT_DEV_ALLOWED_ORIGINS=


# true = CSP เป็นโหมดรายงานอย่างเดียว ไม่บล็อกจริง
# ใช้ตอนอยากดูก่อนว่ามีอะไรจะโดนบล็อกบ้าง ก่อนบังคับใช้
CSP_REPORT_ONLY=false
