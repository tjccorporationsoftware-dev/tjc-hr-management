# ค่าตั้งต้นของหน้าเว็บ — คัดลอกเป็น .env.local (ตอนพัฒนา) หรือ .env.production (ตอนขึ้นจริง)
# ห้ามเติมค่าจริงลงไฟล์นี้ — ไฟล์นี้ขึ้น git


# [บังคับ] ที่อยู่ API ที่เบราว์เซอร์ของผู้ใช้เรียกถึง (ไม่ใช่ที่อยู่ภายในของเซิร์ฟเวอร์)
# ค่านี้ถูกฝังลงบันเดิลตอน build เปลี่ยนตอนรันไม่ได้ ตั้งผิดต้อง build ใหม่อย่างเดียว
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ทดสอบบนมือถือในวงแลนเดียวกัน ใส่ IP เพิ่ม คั่นด้วยจุลภาค · ไม่ใส่ = dev server ตอบ 403
NEXT_DEV_ALLOWED_ORIGINS=

# true = CSP รายงานอย่างเดียว ไม่บล็อกจริง ใช้ตอนอยากดูก่อนว่าจะมีอะไรโดนบล็อก
CSP_REPORT_ONLY=false
