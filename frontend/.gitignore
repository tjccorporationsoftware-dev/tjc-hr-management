# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ไฟล์ตัวอย่างต้องขึ้น git — ที่ห้ามขึ้นคือ .env ตัวจริงที่มีค่าลับ
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# token ที่ e2e global-setup สร้างไว้ใช้ระหว่างรัน
test-results/

e2e/.auth/

# ผลลัพธ์การทดสอบ e2e — ภาพหน้าจอและวิดีโอ สร้างใหม่ได้ทุกครั้งที่รัน
e2e-artifacts/
playwright-report/
test-results/
